def setting_get(cfg, key):
    if key.startswith("show."):
        return _as_bool(_show_cfg(cfg).get(key[5:]), True)
    return cfg.get(key)


def setting_set(cfg, key, value):
    if key.startswith("show."):
        show = dict(_show_cfg(cfg))
        show[key[5:]] = bool(value)
        cfg["show"] = show
    else:
        cfg[key] = value


def choice_index(choices, value):
    try:
        return choices.index(value)
    except ValueError:
        numeric = all(isinstance(x, (int, float)) and not isinstance(x, bool) for x in choices)
        if numeric:
            return min(range(len(choices)), key=lambda i: abs(float(choices[i]) - float(value)))
        return 0


def fmt_setting(key, value):
    if key == "interval":
        v = float(value)
        return f"{v:.2f} с" if v < 1 else f"{v:g} с"
    if key == "history_interval":
        return f"{float(value):g} с"
    if key == "history":
        return f"{value} точек"
    if key == "limit_decimals":
        return str(value)
    if isinstance(value, bool):
        return "вкл" if value else "выкл"
    return str(value)


def apply_setting(app, key, value):
    cfg = app.cfg
    setting_set(cfg, key, value)
    if key == "theme":
        app.theme = Theme(value)
    elif key == "view":
        if value in VIEWS:
            app.view = value
    elif key == "history":
        n = _as_int(value, 120, 10, 5000)
        app.h_cpu = deque(app.h_cpu, maxlen=n)
        app.h_load = deque(app.h_load, maxlen=n)
        app.h_temp = deque(app.h_temp, maxlen=n)
        app.h_io = deque(app.h_io, maxlen=n)
    persist_setting(key, value)


def persist_setting(key, value):
    """Сохранить один ключ, не записывая разовые флаги (--theme, --view) в конфиг."""
    disk = load_config()
    setting_set(disk, key, value)
    save_config(disk)


# та же физическая клавиша в русской раскладке (ЙЦУКЕН)
RU_KEYS = {"к": "r", "К": "R", "е": "t", "Е": "T", "м": "v", "М": "V",
           "ы": "s", "Ы": "S", "з": "p", "З": "P", "й": "q", "Й": "Q",
           "л": "k", "Л": "K", "о": "j", "О": "J", "р": "h", "Р": "H",
           "д": "l", "Д": "L", "в": "d", "В": "D", "ч": "x", "Ч": "X",
           "с": "c", "С": "C", "ь": "m", "Ь": "M", "т": "n", "Т": "N",
           "ш": "i", "Ш": "I", "п": "g", "П": "G", "н": "y", "Н": "Y", "а": "f", "А": "F"}


def read_key(fd, translate=True):
    """Одна клавиша. None — конец ввода (EOF/ошибка), "" — непонятный байт.

    translate=False — без перевода русской раскладки (для ввода текста в поиске).
    """
    def read1():
        try:
            return os.read(fd, 1)
        except OSError:
            return b""

    b = read1()
    if not b:
        return None
    if b != b"\x1b":
        # UTF-8: дочитываем продолжение многобайтного символа
        need = 1 if b[0] >= 0xC0 else 0
        need += 1 if b[0] >= 0xE0 else 0
        need += 1 if b[0] >= 0xF0 else 0
        for _ in range(need):
            r, _, _ = select.select([fd], [], [], 0.02)
            if not r:
                break
            b += read1()
        ch = b.decode("utf-8", "ignore")
        return RU_KEYS.get(ch, ch) if translate else ch
    r, _, _ = select.select([fd], [], [], 0.02)
    if not r:
        return "ESC"
    seq = read1()
    if seq in (b"[", b"O"):
        r, _, _ = select.select([fd], [], [], 0.02)
        if not r:
            return "ESC"
        code = read1()
        if code.isdigit():
            # ESC [ 3 ~ и т.п.: дочитываем до «~»
            num = code
            for _ in range(4):
                r, _, _ = select.select([fd], [], [], 0.02)
                if not r:
                    break
                c2 = read1()
                if c2 == b"~" or not c2:
                    break
                num += c2
            return {b"1": "HOME", b"7": "HOME", b"4": "END", b"8": "END", b"3": "DEL",
                    b"5": "PGUP", b"6": "PGDN"}.get(num.split(b";")[0], "ESC")
        return {b"A": "UP", b"B": "DOWN", b"C": "RIGHT", b"D": "LEFT",
                b"H": "HOME", b"F": "END"}.get(code, "ESC")
    return "ESC"


def render_settings(app, W, H, sel):
    t = app.theme
    ts = datetime.now().strftime("%H:%M:%S")
    left = (f"{t.c('accent', 'AGENTOP')} {t.c('dim', VERSION)} "
            f"{t.c('dim', '·')} {t.c('text', 'настройки')}")
