# ───────────────────────────── ANSI ─────────────────────────────
ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def vlen(s):
    return len(ANSI_RE.sub("", s))


def clip(s, width):
    if vlen(s) <= width:
        return s
    out, vis, i = [], 0, 0
    while i < len(s) and vis < width - 1:
        if s[i] == "\x1b":
            m = ANSI_RE.match(s, i)
            if m:
                out.append(m.group())
                i = m.end()
                continue
        out.append(s[i])
        vis += 1
        i += 1
    out.append("…")
    if COLOR:
        out.append("\033[0m")
    return "".join(out)


def pad(s, width):
    return s + " " * max(0, width - vlen(s))


class Theme:
    def __init__(self, name):
        self.name = resolve_theme(name)
        self.p = THEMES[self.name]

    def c(self, key, s):
        if not COLOR:
            return s
        return f"\033[38;5;{self.p[key]}m{s}\033[0m"

    def bar(self, pct, width):
        pct = max(0.0, min(100.0, float(pct or 0)))
        filled = int(round(width * pct / 100.0))
        if not COLOR:
            return "█" * filled + "░" * (width - filled)
        pal = self.p["palette"]
        cells = []
        for i in range(filled):
            col = pal[min(len(pal) - 1, (i * len(pal)) // max(1, filled))]
            cells.append(f"\033[38;5;{col}m█")
        cells.append(f"\033[38;5;{self.p['dim']}m" + "░" * (width - filled))
        return "".join(cells) + "\033[0m"


