def age_label(seconds):
    seconds = int(max(0, seconds))
    if seconds < 90:
        return f"{seconds}с"
    if seconds < 2 * 3600:
        return f"{seconds // 60}м"
    if seconds < 2 * 86400:
        return f"{seconds // 3600}ч"
    return f"{seconds // 86400}д"


def window_expired(o):
    """Окно лимита уже сброшено, а данные — из кэша до сброса."""
    try:
        reset = datetime.fromisoformat(o["resets_at"].replace("Z", "+00:00")).timestamp()
    except Exception:
        return False
    return reset <= time.time()


def claude_limits(ttl=TTL_LIMITS, force=False):
    if not force and USAGE_CACHE.exists():
        try:
            if time.time() - USAGE_CACHE.stat().st_mtime < ttl:
                data = json.loads(USAGE_CACHE.read_text())
                if "_fetched_at" not in data:
                    data["_fetched_at"] = USAGE_CACHE.stat().st_mtime
                return data
        except Exception:
            pass

    token = None
    try:
        cred = json.loads((HOME / ".claude/.credentials.json").read_text())
        token = (cred.get("claudeAiOauth") or {}).get("accessToken")
    except Exception:
        pass
    if not token:
        return {"error": "нет токена Claude Code — запустите claude"}

    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": f"agentop/{VERSION}",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=4) as r:
            data = json.loads(r.read().decode())
        data["_fetched_at"] = time.time()
        tmp = USAGE_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(data))
        os.chmod(tmp, 0o600)
        tmp.replace(USAGE_CACHE)
        record_limits(data)
        return data
    except urllib.error.HTTPError as e:
        if e.code == 429:
            # не долбим API: продлеваем жизнь кэша и отдаём его молча
            if USAGE_CACHE.exists():
                try:
                    os.utime(USAGE_CACHE, None)
                    data = json.loads(USAGE_CACHE.read_text())
                    data["_throttled"] = True
                    if "_fetched_at" not in data:
                        data["_fetched_at"] = USAGE_CACHE.stat().st_mtime
                    return data
                except Exception:
                    pass
            return {"error": "Claude API: 429, попробуйте позже"}
        err = f"HTTP {e.code}"
    except Exception as e:
        err = e.__class__.__name__

    if USAGE_CACHE.exists():
        try:
            data = json.loads(USAGE_CACHE.read_text())
            data["_stale"] = True
            if "_fetched_at" not in data:
                data["_fetched_at"] = USAGE_CACHE.stat().st_mtime
            return data
        except Exception:
            pass
    return {"error": err}


