    def sep(title):
        return t.c("accent", "▐ ") + t.c("text", title + " ") + t.c("dim", "─" * max(0, w - len(title) - 3))

    i5, i7 = lim_info(data, "5h", "five_hour"), lim_info(data, "7d", "seven_day")
