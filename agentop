        self.net = NetIO()
        self.bat = Battery()
        self.speed = Speed(1800)
        self.force_limits = False
        self.ts = {}
        self.cache = {}
        self.last_hist = 0.0
        self.version = 0
        n = _as_int(cfg.get("history"), 120, 10, 5000)
        self.h_cpu = deque(maxlen=n)
        self.h_load = deque(maxlen=n)
        self.h_temp = deque(maxlen=n)
        self.h_io = deque(maxlen=n)
        self.theme = Theme(cfg.get("theme", "auto"))
        self.view = cfg.get("view", "dashboard")
        if self.view not in VIEWS:
            self.view = "dashboard"
        self._threaded = threaded
        try:
            cached = json.loads(USAGE_CACHE.read_text())
            if isinstance(cached, dict) and not cached.get("error"):
                self.cache["limits"] = cached
        except Exception:
            pass
        self.ts["limits"] = time.time() if threaded else 0.0
        if threaded:
            self._limits_thread = threading.Thread(target=self._limits_worker, daemon=True)
            self._limits_thread.start()
        else:
            self._limits_thread = None

    def _limits_worker(self):
        # фоновое обновление лимитов — не блокирует интерфейс
        delay = 0
        while True:
            if delay:
                time.sleep(delay)
            try:
                data = claude_limits(force=True)
                ok = (bool(data) and not data.get("error")
                      and not data.get("_throttled") and not data.get("_stale"))
                if data and not data.get("error"):
                    self.cache["limits"] = data
                    self.ts["limits"] = time.time()
                if ok:
                    delay = LIMITS_REFRESH
                else:
                    delay = min(300, max(60, (delay or LIMITS_REFRESH) * 2))
            except Exception:
                delay = min(300, max(60, (delay or LIMITS_REFRESH) * 2))

    def _due(self, key, ttl):
        return key not in self.ts or (time.time() - self.ts[key]) >= ttl

    def sample(self, procs=True):
        now = time.time()
        c = self.cache
        show = _show_cfg(self.cfg)
        changed = False

        if self.force_limits:
            c["limits"] = claude_limits(force=True)
            self.force_limits = False
            self.ts["limits"] = now
            changed = True
        elif not self._threaded:
            if "limits" not in self.cache or self._due("limits", TTL_LIMITS):
                c["limits"] = claude_limits()
                self.ts["limits"] = now
                changed = True
            else:
                c["limits"] = self.cache.get("limits")
        elif self._due("limits", TTL_LIMITS_FALLBACK):
            c["limits"] = claude_limits()
            self.ts["limits"] = now
            changed = True
        else:
            c["limits"] = self.cache.get("limits")
        if self._due("claude", TTL_CLAUDE):
            c["claude"] = claude_today()
            self.ts["claude"] = now
            changed = True
        if self._due("oc", TTL_OC):
            c["oc"] = opencode_stats()
            self.ts["oc"] = now
            changed = True
        if self._due("cpu", TTL_CPU):
            c["pcts"] = self.cpu.pcts()
            self.ts["cpu"] = now
            changed = True
        if self._due("sys", TTL_SYS):
            try:
                c["load"] = os.getloadavg()
            except Exception:
                c["load"] = (0.0, 0.0, 0.0)
            c["mem"] = meminfo()
            c["temp"] = temperature()
            c["gpu"] = gpu_busy() if _as_bool(show.get("gpu"), True) else None
            c["gt"] = gpu_temp() if _as_bool(show.get("gpu"), True) else None
            c["bat"] = self.bat.read()
            c["uptime"] = uptime()
            self.ts["sys"] = now
            changed = True
        if self._due("io", TTL_IO):
            c["disk"] = self.disk.rates() if _as_bool(show.get("disk"), True) else None
            c["net"] = self.net.rates() if _as_bool(show.get("network"), True) else None
            c["root"] = disk_usage_root()
            self.ts["io"] = now
            changed = True
        if procs and self._due("procs", TTL_PROCS):
            c["procs"] = top_procs(4) if _as_bool(show.get("processes"), True) else []
            self.ts["procs"] = now
            changed = True
        if self._due("speed", TTL_SPEED):
            self.speed.update()
            self.ts["speed"] = now
            changed = True

        hist_every = _as_float(self.cfg.get("history_interval"), 2.0, 0.2, 60.0)
        if now - self.last_hist >= hist_every:
            total = next((p for n, p in c.get("pcts", []) if n == "cpu"), 0.0) or 0.0
            self.h_cpu.append(total)
            self.h_load.append((c.get("load") or (0.0, 0.0, 0.0))[0])
            self.h_temp.append(c.get("temp") or 0)
            disk = c.get("disk")
            self.h_io.append((disk[0] + disk[1]) if disk else 0)
            self.last_hist = now
            changed = True

        if changed:
            self.version += 1

        return {
            "version": self.version,
            "limits": c.get("limits"),
            "claude": c.get("claude"),
            "opencode": c.get("oc"),
            "speed": self.speed,
            "pcts": c.get("pcts", []),
            "load": c.get("load", (0.0, 0.0, 0.0)),
            "mem": c.get("mem"),
            "temp": c.get("temp"),
            "gpu": c.get("gpu"),
            "gpu_temp": c.get("gt"),
            "bat": c.get("bat"),
            "disk": c.get("disk"),
            "net": c.get("net"),
            "iface": self.net.iface,
            "root": c.get("root") or disk_usage_root(),
            "procs": c.get("procs", []),
            "uptime": c.get("uptime", 0.0),
            "hist_cpu": list(self.h_cpu),
            "hist_load": list(self.h_load),
            "hist_temp": list(self.h_temp),
            "hist_io": list(self.h_io),
        }


def _header(app, data, W, show_ms):
    t = app.theme
    ts = (datetime.now().strftime("%H:%M:%S.%f")[:-4] if show_ms
          else datetime.now().strftime("%H:%M:%S"))
    lim = data.get("limits") or {}
    worst = 0.0
    for key_ in ("five_hour", "seven_day"):
        u = (lim.get(key_) or {}).get("utilization")
        if u is not None:
            worst = max(worst, float(u))
    dot = "red" if lim.get("error") else pct_color(worst)
    left = (f"{t.c(dot, '●')} {t.c('accent', 'AGENTOP')} {t.c('dim', VERSION)} "
            f"{t.c('dim', '·')} {t.c('text', t.name)}")
    if app.view != "dashboard":
        left += f" {t.c('dim', '·')} {t.c('text', app.view)}"
    extras = []
    if W >= 80:
        if data.get("bat") and data["bat"].get("cap") is not None:
            extras.append(f"{data['bat']['cap']}%")
        if data.get("temp"):
            extras.append(f"{data['temp']:.0f}°C")
    extras.append(f"up {human_left(data['uptime'])}")
    right = t.c("dim", f"{ts} · {' · '.join(extras)}")
    return frame_top(t, W, left, right)


def _footer(app, W, paused):
    t = app.theme
    if paused:
        hint = f"{key(t, 'p')} продолжить   {key(t, 'q')} выход"
    else:
        hint = (f"{key(t, 'r')} обновить   {key(t, 't')} тема   {key(t, 'v')} вид   "
                f"{key(t, 'p')} пауза   {key(t, 'q')} выход")
    return frame_bottom(t, W, hint)


def limits_title(data):
    lim = data.get("limits") or {}
    fa = lim.get("_fetched_at")
    title = "LIMITS"
    if fa:
        title += f" · {age_label(time.time() - fa)}"
    if lim.get("_throttled"):
        title += " · 429"
    return title


def _agent_blocks(app, data, t, cw, decimals):
    return [
        ("limits", limits_title(data), limits_lines(data["limits"], t, cw, decimals), False),
        ("tokens", "ТОКЕНЫ · СЕГОДНЯ",
         tokens_lines(data["claude"], data["opencode"], t, cw), False),
        ("speed", "СКОРОСТЬ ТОКЕНОВ · 15 МИН", None, False),
    ]


def _system_blocks(app, data, t, cw):
    mem_title = "ПАМЯТЬ · ТЕМПЕРАТУРА" + (" · GPU" if data["gpu"] is not None else "")
    blocks = [
        ("cpu", "CPU", None, False),
        ("mem", mem_title,
         mem_lines(data["mem"], data["temp"], data["gpu"], data["gpu_temp"],
                   data["hist_temp"], t, cw), False),
        ("power", "ПИТАНИЕ", power_lines(data["bat"], t, cw), True),
    ]
    if data["disk"] or data["net"]:
        blocks.append(("io", "ДИСК · СЕТЬ",
                       io_lines(data["disk"], data["net"], data["root"], data["iface"],
                                data["hist_io"], t, cw), True))
    if data["procs"]:
        blocks.append(("procs", "ТОП ПРОЦЕССОВ", proc_lines(data["procs"], t, cw), True))
    return blocks


def _stacked(app, data, W, H, show_ms, paused, blocks, pc=True, big=False, options=None):
    t = app.theme
    cw = W - 4
    top = _header(app, data, W, show_ms)
    bottom = _footer(app, W, paused)

    def compose(per_core=True, optional=True, big_graph=big, tiny=False):
        out = [top]
        for name, title, lines, opt in blocks:
            if opt and not optional:
                continue
            if tiny and name == "mem":
                continue
            out.append(content_line(t, W, head(t, cw, title)))
            if name == "cpu":
                body = cpu_lines(data["pcts"], data["load"], data["hist_cpu"],
                                 data["hist_load"], t, cw, per_core=per_core)
            elif name == "speed":
                body = speed_lines(data["speed"], t, cw, big=big_graph)
            else:
                body = lines
            out.extend(content_line(t, W, x) for x in body)
        out.append(bottom)
        return [clip(x, W) for x in out]

    if options is None:
        options = [(pc, True, big, False), (pc, False, big, False)]
        if pc:
            options.append((False, False, big, False))
        options += [(False, False, False, False), (False, False, False, True)]
    for per_core, optional, big_graph, tiny in options:
        lines = compose(per_core, optional, big_graph, tiny)
        if len(lines) <= H:
            return lines
    return compose(False, False, False, True)[:H]


def _single_column(app, data, W, H, show_ms, paused):
    t = app.theme
    decimals = _as_int(app.cfg.get("limit_decimals"), 3, 0, 6)
    cw = W - 4
    blocks = _agent_blocks(app, data, t, cw, decimals) + _system_blocks(app, data, t, cw)
    pc = _as_bool(_show_cfg(app.cfg).get("per_core"), True)
    return _stacked(app, data, W, H, show_ms, paused, blocks, pc=pc, big=H >= 34)


def _focus_view(app, data, W, H, show_ms, paused):
    t = app.theme
    decimals = _as_int(app.cfg.get("limit_decimals"), 3, 0, 6)
    cw = W - 4
    blocks = _agent_blocks(app, data, t, cw, decimals)
    big = H >= 26
    return _stacked(app, data, W, H, show_ms, paused, blocks, pc=False,
                    big=big, options=[(False, False, big, False)])


def _system_view(app, data, W, H, show_ms, paused):
    t = app.theme
    cw = W - 4
    blocks = _system_blocks(app, data, t, cw)
    pc = _as_bool(_show_cfg(app.cfg).get("per_core"), True)
    return _stacked(app, data, W, H, show_ms, paused, blocks, pc=pc, big=False)


def _compact_view(app, data, W, H, show_ms, paused):
    t = app.theme
    decimals = _as_int(app.cfg.get("limit_decimals"), 3, 0, 6)
    cw = W - 4
    mem_title = "ПАМЯТЬ · ТЕМП"
    blocks = _agent_blocks(app, data, t, cw, decimals)
    blocks += [
        ("cpu", "CPU", None, False),
        ("mem", mem_title,
         mem_lines(data["mem"], data["temp"], data["gpu"], data["gpu_temp"],
                   data["hist_temp"], t, cw), False),
    ]
    return _stacked(app, data, W, H, show_ms, paused, blocks, pc=False,
                    big=False, options=[(False, False, False, False)])


def _minimal_view(app, data, W, H, show_ms, paused):
    t = app.theme
    decimals = _as_int(app.cfg.get("limit_decimals"), 3, 0, 6)
    out = [_header(app, data, W, show_ms)]
    lim = data.get("limits") or {}
    for label, key_ in (("5h", "five_hour"), ("7d", "seven_day")):
        o = lim.get(key_) or {}
        used = o.get("utilization")
        if used is None:
            out.append(content_line(t, W, f"  {t.c('text', label)}  {t.c('dim', 'нет данных')}"))
            continue
        used = float(used)
        rem = ""
        if o.get("resets_at"):
            try:
                reset = datetime.fromisoformat(o["resets_at"].replace("Z", "+00:00")).timestamp()
                rem = f"  {t.c('dim', '↻')} {human_left(reset - time.time())}"
            except Exception:
                pass
        pct = f"{used:.{decimals}f}%"
        out.append(content_line(t, W,
            f"  {t.c('text', label)}  {t.bar(used, 14)} {t.c(pct_color(used), pct)}{rem}"))
    snap = data["speed"].snapshot()
    now_rate = snap["now"]
    load0 = data["load"][0]
    total = next((p for n, p in data["pcts"] if n == "cpu"), 0.0) or 0.0
    bat = data["bat"] or {}
    line = (f"  {t.c('dim', 'tok/s')} {t.c('green', f'{now_rate:.0f}')}"
            f"  {t.c('dim', 'load')} {load0:.2f}"
            f"  {t.c('dim', 'CPU')} {t.c(pct_color(total), f'{total:.0f}%')}")
    if bat.get("cap") is not None:
        line += f"  {t.c('dim', 'BAT')} {bat['cap']}%"
    out.append(content_line(t, W, line))
    out.append(_footer(app, W, paused))
    return [clip(x, W) for x in out][:H]


def _double_column(app, data, W, H, show_ms, paused):
    t = app.theme
    decimals = _as_int(app.cfg.get("limit_decimals"), 3, 0, 6)
    top = _header(app, data, W, show_ms)
    bottom = _footer(app, W, paused)
    lw = (W - 7) // 2
    rw = W - 7 - lw
    mem_title = "ПАМЯТЬ · ТЕМПЕРАТУРА" + (" · GPU" if data["gpu"] is not None else "")

    def col(title, body, width):
        return [head(t, width, title)] + [clip(x, width) for x in body]

    def build(per_core=True, optional=True):
        left = []
        left += col(limits_title(data), limits_lines(data["limits"], t, lw, decimals), lw)
        left += col("ТОКЕНЫ · СЕГОДНЯ", tokens_lines(data["claude"], data["opencode"], t, lw), lw)
        left += col("СКОРОСТЬ ТОКЕНОВ", speed_lines(data["speed"], t, lw, big=False), lw)

        right = []
        right += col("CPU", cpu_lines(data["pcts"], data["load"], data["hist_cpu"],
                                      data["hist_load"], t, rw, per_core=per_core), rw)
        right += col(mem_title, mem_lines(data["mem"], data["temp"], data["gpu"],
                                          data["gpu_temp"], data["hist_temp"], t, rw), rw)
        if optional:
            if data["bat"] and data["bat"].get("cap") is not None:
                right += col("ПИТАНИЕ", power_lines(data["bat"], t, rw), rw)
            if data["disk"] or data["net"]:
                right += col("ДИСК · СЕТЬ", io_lines(data["disk"], data["net"], data["root"],
                                                     data["iface"], data["hist_io"], t, rw), rw)
            if data["procs"]:
                right += col("ТОП ПРОЦЕССОВ", proc_lines(data["procs"], t, rw), rw)

        rows = max(len(left), len(right))
        left += [""] * (rows - len(left))
        right += [""] * (rows - len(right))
        out = [top]
        for l, r in zip(left, right):
            out.append(t.c("dim", "│ ") + pad(l, lw) + t.c("dim", " │ ") + pad(r, rw) + t.c("dim", " │"))
        out.append(bottom)
        return [clip(x, W) for x in out]

    pc = _as_bool(_show_cfg(app.cfg).get("per_core"), True)
    for per_core, optional in ((pc, True), (pc, False), (False, False)):
        lines = build(per_core, optional)
        if len(lines) <= H:
            return lines
    return build(False, False)[:H]


def render(app, data, W, H, show_ms=False, paused=False):
    if app.view == "focus":
        return _focus_view(app, data, W, H, show_ms, paused)
    if app.view == "system":
        return _system_view(app, data, W, H, show_ms, paused)
    if app.view == "compact":
        return _compact_view(app, data, W, H, show_ms, paused)
    if app.view == "minimal":
        return _minimal_view(app, data, W, H, show_ms, paused)
    if W >= 96:
        return _double_column(app, data, W, H, show_ms, paused)
    return _single_column(app, data, W, H, show_ms, paused)


def short(app, data):
    lim = data["limits"] or {}
    parts = []
    if lim.get("error"):
        parts.append("claude --")
    else:
        for label, key in (("5h", "five_hour"), ("7d", "seven_day")):
            o = lim.get(key) or {}
            if o.get("utilization") is not None:
                parts.append(f"{label} {max(0, 100 - float(o['utilization'])):.0f}% left")
    parts.append(f"{data['speed'].rate(60):.0f} tok/s")
    otot = (data["opencode"] or {}).get("today") or {}
    if otot:
        parts.append(f"${float(otot.get('cost') or 0):.3f}")
    parts.append(f"load {data['load'][0]:.1f}")
    total = next((p for n, p in data["pcts"] if n == "cpu"), None)
    if total is not None:
        parts.append(f"cpu {total:.0f}%")
    if data["bat"] and data["bat"].get("cap") is not None:
        parts.append(f"bat {data['bat']['cap']}%")
    return " · ".join(parts)


def json_out(app, data):
    lim = data["limits"] or {}
    otot = (data["opencode"] or {}).get("today") or {}
    ctot = (data["claude"] or {}).get("totals") or {}
    total = next((p for n, p in data["pcts"] if n == "cpu"), None)
    return json.dumps({
        "version": VERSION,
        "theme": app.theme.name,
        "limits": {"five_hour": lim.get("five_hour"), "seven_day": lim.get("seven_day"),
                   "error": lim.get("error"), "stale": lim.get("_stale", False)},
        "claude": {"totals": ctot, "date": (data["claude"] or {}).get("date")},
        "opencode": {"today": otot, "all_cost": (data["opencode"] or {}).get("all_cost")},
        "speed": {"now": data["speed"].rate(30), "avg5m": data["speed"].rate(300),
                  "peak": data["speed"].peak(60, 900)},
        "system": {"load": list(data["load"]), "cpu": total,
                   "cores": [p for n, p in data["pcts"] if n != "cpu"],
                   "mem": data["mem"], "temp": data["temp"],
                   "gpu": data["gpu"], "gpu_temp": data["gpu_temp"],
                   "battery": data["bat"], "disk": data["disk"],
                   "net": data["net"], "iface": data["iface"],
                   "uptime": data["uptime"]},
        "processes": data["procs"],
    }, ensure_ascii=False, indent=2)


# ───────────────────────────── main ─────────────────────────────
def main():
    ap = argparse.ArgumentParser(add_help=True, description="agentop — агенты и железо")
    ap.add_argument("--once", action="store_true", help="вывести один раз")
    ap.add_argument("--short", action="store_true", help="одна строка")
    ap.add_argument("--json", action="store_true", help="JSON")
    ap.add_argument("--refresh", "-r", action="store_true", help="сбросить кэш")
    ap.add_argument("--theme", help="тема на один запуск")
    ap.add_argument("--set-theme", help="сохранить тему в конфиг")
    ap.add_argument("--list-themes", action="store_true", help="список тем")
    ap.add_argument("--view", choices=VIEWS, help="вид: " + ", ".join(VIEWS))
    ap.add_argument("--list-views", action="store_true", help="список видов")
    ap.add_argument("--config", action="store_true", help="показать конфиг")
    ap.add_argument("--ms", action="store_true", help="часы с сантисекундами; включает -i 0.01 (нагружает)")
    ap.add_argument("--version", action="version", version=f"agentop {VERSION}")
    ap.add_argument("-i", "--interval", type=float, help="интервал обновления, сек")
    args = ap.parse_args()

    cfg = load_config()

    if args.list_themes:
        print("auto (по теме GNOME) +")
        for name in THEMES:
            print("  " + name)
        return

    if args.list_views:
        desc = {
            "dashboard": "агенты + система (две колонки на широких)",
            "focus": "только лимиты, токены и скорость",
            "system": "только железо",
            "compact": "компактная одна колонка",
            "minimal": "5–6 строк",
        }
        for v in VIEWS:
            print(f"  {v:10s} {desc[v]}")
        return

    if args.set_theme:
        name = args.set_theme
        if name not in THEMES and name != "auto":
            print(f"неизвестная тема: {name}", file=sys.stderr)
            return 2
        cfg["theme"] = name
        save_config(cfg)
        print(f"тема сохранена: {name}")
        return

    if args.config:
        print(CONFIG_PATH)
        print(json.dumps(cfg, indent=2, ensure_ascii=False))
        return

    if args.theme:
        cfg["theme"] = args.theme
    if args.refresh:
        clear_cache()

    one_shot = (args.once or args.short or args.json
                or not (sys.stdout.isatty() and sys.stdin.isatty()))

    app = App(cfg, threaded=not one_shot)
    if args.view:
        app.view = args.view
    if args.refresh:
        app.force_limits = True
    interval = max(0.01, args.interval if args.interval is not None
                   else _as_float(cfg.get("interval"), 1.0, 0.01, 3600.0))
    if args.ms and args.interval is None and interval > 0.05:
        interval = 0.01
    show_ms = bool(args.ms or _as_bool(cfg.get("clock_ms"), False))

    size = shutil.get_terminal_size((80, 24))
    W = max(52, min(size.columns - 1, 120))
    H = max(20, size.lines)

    if one_shot:
        time.sleep(0.35)
        data = app.sample()
        if args.json:
            print(json_out(app, data))
        elif args.short:
            print(short(app, data))
        else:
            print("\n".join(render(app, data, W, H, show_ms=show_ms)))
        return

    # живой режим
    fd = sys.stdin.fileno()
    old_term = None
    if termios and tty and sys.stdin.isatty():
        try:
            old_term = termios.tcgetattr(fd)
            tty.setcbreak(fd)
        except Exception:
            old_term = None

    time.sleep(0.35)
    last_frame = None
    last_stamp = None
    last_size_check = 0.0
    paused = False
    try:
        while True:
            if paused:
                r, _, _ = select.select([sys.stdin], [], [], None)
                if not r:
                    continue
                ch = sys.stdin.read(1)
                if not ch:
                    break
                if ch in ("q", "Q", "\x03", "\x1b"):
                    break
                if ch in ("p", "P"):
                    paused = False
                    last_frame = None
                    last_stamp = None
                continue

            tick_start = time.time()
            now = tick_start
            if now - last_size_check >= 0.5:
                size = shutil.get_terminal_size((80, 24))
                W = max(52, min(size.columns - 1, 120))
                H = max(20, size.lines)
                last_size_check = now

            data = app.sample()
            stamp = (data["version"], int(now), W, H, app.theme.name)
            if show_ms or stamp != last_stamp:
                frame = "\n".join(render(app, data, W, H, show_ms=show_ms))
                if frame != last_frame:
                    sys.stdout.write("\033[H\033[J" + frame)
                    sys.stdout.flush()
                    last_frame = frame
                last_stamp = stamp

            wait = max(0.0, interval - (time.time() - tick_start))
            r, _, _ = select.select([sys.stdin], [], [], wait)
            if not r:
                continue
            ch = sys.stdin.read(1)
            if not ch:
                break
            if ch in ("q", "Q", "\x03", "\x1b"):
                break
            if ch in ("r", "R"):
                clear_cache()
                app.ts.clear()
                app.cache.clear()
                app.force_limits = True
                app.speed.claude = ClaudeTail(1800)
                app.speed.update(force=True)
                last_frame = None
                last_stamp = None
            elif ch in ("t", "T"):
                names = list(THEMES)
                cur = app.theme.name
                nxt = names[(names.index(cur) + 1) % len(names)] if cur in names else names[0]
                app.theme = Theme(nxt)
                cfg["theme"] = nxt
                save_config(cfg)
                last_frame = None
                last_stamp = None
            elif ch in ("p", "P"):
                paused = True
                frame = "\n".join(render(app, data, W, H, show_ms=show_ms, paused=True))
                if frame != last_frame:
                    sys.stdout.write("\033[H\033[J" + frame)
                    sys.stdout.flush()
                    last_frame = frame
            elif ch in ("v", "V"):
                idx = VIEWS.index(app.view) if app.view in VIEWS else 0
                app.view = VIEWS[(idx + 1) % len(VIEWS)]
                cfg["view"] = app.view
                save_config(cfg)
                last_frame = None
                last_stamp = None
    except (KeyboardInterrupt, OSError):
        pass
    finally:
        if old_term is not None:
            try:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_term)
            except Exception:
                pass
        try:
            app.speed.claude._save()
        except Exception:
            pass
        try:
            sys.stdout.write("\033[H\033[J")
            sys.stdout.flush()
        except Exception:
            pass


if __name__ == "__main__":
    main()
