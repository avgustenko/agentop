    if not info or info["expired"]:
        body.append("  " + _no_limits(t, info))
    else:
        left = max(0.0, 100 - info["used"])
        cells = max(6, min(14, (cw - 26) // 3))
        filled = round(left / 100 * cells)
        col = "green" if left > 50 else "yellow" if left > 20 else "red"
        row = t.c("dim", "  ┃") + "".join(t.c(col, "██ ") if i < filled else t.c("dim", "░░ ") for i in range(cells)) + t.c("dim", "┃█")
        body.append(t.c("dim", "  ┏" + "━" * (cells * 3) + "┓"))
        body.append(row + f"   {t.c(col, f'{left:.0f}%')} {t.c('dim', 'осталось')}")
        body.append(row + f"   {t.c('dim', '↻')} {human_left(info['rem'] or 0)}")
        body.append(t.c("dim", "  ┗" + "━" * (cells * 3) + "┛"))
        if info["rate"]:
            secs = left / info["rate"]
            body.append(f"  {t.c('dim', 'запас')}  {t.c('text', human_left(secs))} {t.c('dim', 'работы при расходе')} {info['rate'] * 3600:.0f}%/ч")
            if secs >= (info["rem"] or 0):
                body.append("  " + t.c("green", "бак заправится сбросом раньше, чем опустеет"))
            else:
                body.append("  " + t.c("red", f"опустеет за {human_left((info['rem'] or 0) - secs)} до сброса — сбавьте темп"))
        else:
            body.append("  " + t.c("dim", "запас: считаю расход, нужно 10 минут журнала"))
    w7 = lim_info(data, "7d", "seven_day")
    body.append("")
    if w7 and not w7["expired"]:
        f7 = round((100 - w7["used"]) / 100 * 20)
        body.append(f"  {t.c('dim', 'неделя ▕')}" + t.c("green", "█" * f7) + t.c("dim", "░" * (20 - f7) + "▏")
                    + f" {100 - w7['used']:.0f}% " + t.c("dim", f" ↻ {human_left(w7['rem'] or 0)}"))
    ctot = (data.get("claude") or {}).get("totals") or {}
    otot = (data.get("opencode") or {}).get("today") or {}
    toks = int(ctot.get("output", 0)) + int(otot.get("output", 0)) + int(otot.get("reasoning", 0))
    odo = "".join(t.c("dim", "│") + t.c("text", ch) for ch in f"{toks:08d}"[-8:])
    cost = float(ctot.get("cost_api") or 0) + float(otot.get("cost") or 0)
    body.append(f"  {t.c('dim', 'пробег сегодня')} {odo}{t.c('dim', '│ токенов')}  {t.c('yellow', f'≈${cost:.2f}')}")
    now_s, _, buckets = _speed_now(data)
    body.append(f"  {t.c('dim', 'скорость')}       {t.c('green', f'{now_s:.0f} tok/s')} {sparkline(buckets, t, 'gradient', 24)}")
    return _framed(app, data, W, H, show_ms, paused, body)


