    out = [t.c(pct_color(worst), "● ") + t.c("accent", "AGENTOP") + " " * max(1, w - 10 - len(ts)) + t.c("dim", ts), "", sep("ЛИМИТЫ")]
    for info, label in ((i5, "5h"), (i7, "7d")):
