    cw = W - 4
    items = settings_items(app.cfg)
    out = [top, content_line(t, W, head(t, cw, "НАСТРОЙКИ"))]
    for i, (key, label, choices) in enumerate(items):
        val = setting_get(app.cfg, key)
        vtxt = fmt_setting(key, val)
        pointer = "›" if i == sel else " "
        row = f"  {t.c('accent' if i == sel else 'dim', pointer)} {label:<22} {t.c('text', vtxt)}"
        out.append(content_line(t, W, row))
    out.append(content_line(t, W, t.c("dim", "  Обновление: 0.01 … 300 с · ←/→ меняет значение")))
