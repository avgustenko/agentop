def _double_column(app, data, W, H, show_ms, paused):
    t = app.theme
    decimals = _as_int(app.cfg.get("limit_decimals"), 3, 0, 6)
    top = _header(app, data, W, show_ms)
    bottom = _footer(app, W, paused)
    lw = (W - 7) // 2
    rw = W - 7 - lw
    mem_title = "ПАМЯТЬ · ТЕМПЕРАТУРА" + (" · GPU" if data["gpu"] is not None else "")

    def col(title, body, width):
        return [head(t, width, title)] + [clip(x, width) for x in body]

    def build(per_core=True, optional=True):
        left = []
        left += col(limits_title(data), limits_lines(data["limits"], t, lw, decimals,
                                                     data.get("limits_hist")), lw)
        left += col("ТОКЕНЫ · СЕГОДНЯ", tokens_lines(data["claude"], data["opencode"], t, lw), lw)
        left += col("СКОРОСТЬ ТОКЕНОВ", speed_lines(data["speed"], t, lw, big=False), lw)
        if optional and _as_bool(_show_cfg(app.cfg).get("models"), True):
            cost = float(((data["claude"] or {}).get("totals") or {}).get("cost_api") or 0)
            left += col(f"МОДЕЛИ · Claude ≈${cost:.2f} API",
                        models_lines(data["claude"], data["opencode"], t, lw, limit=5), lw)

        right = []
        right += col("CPU", cpu_lines(data["pcts"], data["load"], data["hist_cpu"],
                                      data["hist_load"], t, rw, per_core=per_core), rw)
        right += col(mem_title, mem_lines(data["mem"], data["temp"], data["gpu"],
                                          data["gpu_temp"], data["hist_temp"], t, rw), rw)
        if optional:
            if data["bat"] and data["bat"].get("cap") is not None:
                right += col("ПИТАНИЕ", power_lines(data["bat"], t, rw), rw)
            if data["disk"] or data["net"]:
                right += col("ДИСК · СЕТЬ", io_lines(data["disk"], data["net"], data["root"],
                                                     data["iface"], data["hist_io"], t, rw), rw)
            if data["procs"]:
                right += col("ТОП ПРОЦЕССОВ", proc_lines(data["procs"], t, rw), rw)

        rows = max(len(left), len(right))
        left += [""] * (rows - len(left))
        right += [""] * (rows - len(right))
        out = [top]
        for l, r in zip(left, right):
            out.append(t.c("dim", "│ ") + pad(l, lw) + t.c("dim", " │ ") + pad(r, rw) + t.c("dim", " │"))
        out.append(bottom)
        return [clip(x, W) for x in out]

    pc = _as_bool(_show_cfg(app.cfg).get("per_core"), True)
    for per_core, optional in ((pc, True), (pc, False), (False, False)):
        lines = build(per_core, optional)
        if len(lines) <= H:
            return lines
    return build(False, False)[:H]


