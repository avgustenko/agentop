# ── timeline: ось окна 5h с прогнозом ──
def _timeline_view(app, data, W, H, show_ms, paused):
    t = app.theme
    cw = W - 4
    info = lim_info(data, "5h", "five_hour")
    if not info or info["expired"] or not info["reset"]:
        return _framed(app, data, W, H, show_ms, paused,
                       [head(t, cw, "ОКНО 5h"), "  " + _no_limits(t, info)])
    wlen = 5 * 3600
    start, now = info["reset"] - wlen, time.time()
    body = [head(t, cw, f"ОКНО 5h · {hhmm(start)} → {hhmm(info['reset'])}")]
    C = max(20, cw - 7)
    R = 7 if H >= 24 else 5 if H >= 19 else 3
    now_col = min(C - 1, max(0, int((now - start) / wlen * C)))
    pts = sorted(info["pts"]) + [(now, info["used"])]
    pal = t.p["palette"]
    th_row = R - 1 - int(0.8 * R)

    def val_at(ts):
        v = 0.0
        for a, b in pts:
            if a <= ts:
                v = b
        return v

    for r in range(R):
        level = R - 1 - r
        yl = "100%┤" if r == 0 else " 80%┤" if r == th_row else "  0%┤" if r == R - 1 else "    │"
        cells = []
        for i in range(C):
            ts = start + (i + 0.5) / C * wlen
            if i <= now_col:
                v = info["used"] if i == now_col else val_at(ts)
                fill = max(0, min(8, round(v / 100 * R * 8 - level * 8)))
                if fill:
                    col = t.p["accent"] if i == now_col else pal[min(len(pal) - 1, level * len(pal) // R)]
                    cells.append(_cell(SPARK_CHARS[fill - 1], col))
                elif i == now_col:
                    cells.append(t.c("accent", "│"))
                else:
                    cells.append(t.c("dim", "┈") if r == th_row else " ")
            else:
                p = None if info["rate"] is None else info["used"] + info["rate"] * (ts - now)
                if p is not None and p >= 100 and r == 0:
                    cells.append(t.c("red", "·"))
                elif p is not None and p < 100 and R - 1 - min(R - 1, int(p / 100 * R)) == r:
                    cells.append(t.c("yellow" if p >= 80 else "dim", "·"))
                else:
                    cells.append(t.c("dim", "┈") if r == th_row else " ")
        body.append(" " + t.c("dim", yl) + "".join(cells))
    body.append(" " + t.c("dim", "    └" + "─" * C))
    labels = [" "] * C
    first_hour = (int(start // 3600) + 1) * 3600
    for hts in range(first_hour, int(info["reset"]), 3600):
        col = int((hts - start) / wlen * C)
        lab = hhmm(hts)
        if 0 <= col and col + len(lab) <= C and all(c == " " for c in labels[max(0, col - 1):col + len(lab)]):
            labels[col:col + len(lab)] = list(lab)
    body.append("      " + t.c("dim", "".join(labels)))
    body.append("      " + " " * now_col + t.c("accent", "▲ сейчас"))
    line = f"  {t.c('text', 'сейчас')} {t.c(pct_color(info['used']), f'{info['used']:.0f}%')}"
    if info["rate"] is not None:
        line += f"  {t.c('dim', '· темп')} {info['rate'] * 3600:.1f}%/ч"
        line += f"  {t.c('dim', '· к сбросу')} {t.c(_proj_color(info['proj']), f'≈{min(999, info['proj']):.0f}%')}"
        if info["proj"] >= 100 and info["rate"] > 0:
            line += "  " + t.c("red", f"· закончится через {human_left((100 - info['used']) / info['rate'])}")
        else:
            line += "  " + t.c("green", "· запаса хватит")
    else:
        line += "  " + t.c("dim", "· тренд появится через 10 минут журнала")
    body.append(line)
    w7 = lim_info(data, "7d", "seven_day")
    now_s, peak, buckets = _speed_now(data)
    extra = f"  {t.c('dim', 'неделя')} "
    extra += (t.c(pct_color(w7["used"]), f"{w7['used']:.1f}%") + t.c("dim", f" · ↻ {human_left(w7['rem'] or 0)}")) if w7 else t.c("dim", "—")
    extra += f"   {t.c('dim', 'tok/s')} {t.c('green', f'{now_s:.0f}')} {sparkline(buckets, t, 'gradient', 20)}"
    body.append(extra)
    return _framed(app, data, W, H, show_ms, paused, body)


# ── gauges: стрелочные приборы точками Брайля ──
def braille_gauge(pct, wch, rows, t):
    Wd, Hd = wch * 2, rows * 4
    cx, cy = (Wd - 1) / 2, Hd - 1
    r = min(Wd / 2 - 1, Hd - 1)
    bits = [[0] * wch for _ in range(rows)]
    arc = [[-1.0] * wch for _ in range(rows)]
    needle = [[False] * wch for _ in range(rows)]

    def put(x, y):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < Wd and 0 <= y < Hd:
            bits[y >> 2][x >> 1] |= BRAILLE_BITS[x % 2][y % 4]
            return x >> 1, y >> 2
        return None

    steps = max(120, int(math.pi * r * 3))
    for k in range(steps + 1):
        a = math.pi - math.pi * k / steps
        frac = k / steps
        for rr in (r - 2, r - 1, r):
            c = put(cx + rr * math.cos(a), cy - rr * math.sin(a))
            if c:
                arc[c[1]][c[0]] = max(arc[c[1]][c[0]], frac)
    na = math.pi - max(0.0, min(100.0, pct)) / 100 * math.pi
    k = 0.0
    while k <= r - 4:
        c = put(cx + k * math.cos(na), cy - k * math.sin(na))
        if c:
            needle[c[1]][c[0]] = True
        k += 0.5
    pal, p = t.p["palette"], pct / 100
    out = []
    for ri in range(rows):
        line = []
        for ci in range(wch):
            b = bits[ri][ci]
            ch = chr(0x2800 + b) if b else " "
            if needle[ri][ci]:
                line.append(t.c("text", ch))
            elif arc[ri][ci] < 0:
                line.append(ch)
            elif arc[ri][ci] <= p:
                line.append(_cell(ch, pal[min(len(pal) - 1, int(arc[ri][ci] * len(pal)))]))
            else:
                line.append(t.c("dim", ch))
        out.append("".join(line))
    return out


def _gauges_view(app, data, W, H, show_ms, paused):
    t = app.theme
    cw = W - 4
    n = 3 if cw >= 60 else 2 if cw >= 40 else 1
    gw = min(28, (cw - 2 - 3 * (n - 1)) // n)
    rows = 7 if H >= 24 else 5 if H >= 18 else 4
    now_s, peak, _ = _speed_now(data)
    scale = max(100, int(math.ceil(max(peak, now_s) * 1.2 / 100.0)) * 100)
    g = []
    for label, key, title in (("5h", "five_hour", "ОКНО 5 ЧАСОВ"), ("7d", "seven_day", "НЕДЕЛЯ")):
        info = lim_info(data, label, key)
        if not info or info["expired"]:
            g.append((0, "—", title, "нет данных" if not info else "окно сброшено", "dim", "100"))
            continue
        sub = f"↻ {human_left(info['rem'] or 0)}"
        if info["proj"] is not None:
            sub += f"  → {min(999, info['proj']):.0f}%"
        g.append((info["used"], f"{info['used']:.0f}%", title, sub, pct_color(info["used"]), "100"))
    g.append((now_s / scale * 100, f"{now_s:.0f}", "TOK/S", f"пик {peak:.0f}", "green", str(scale)))
    g = g[:n]
    drawn = [braille_gauge(x[0], gw, rows, t) for x in g]
    sep = "   "
    body = [""]
    for r in range(rows):
        body.append("  " + sep.join(d[r] for d in drawn))
    body.append("  " + sep.join(_fitw(t.c("dim", "0") + " " * (gw - 1 - len(x[5])) + t.c("dim", x[5]), gw) for x in g))
    body.append("  " + sep.join(_fitw(_center(t.c(x[4], x[1]), gw), gw) for x in g))
    body.append("  " + sep.join(_fitw(_center(t.c("text", x[2]), gw), gw) for x in g))
    body.append("  " + sep.join(_fitw(_center(t.c("dim", x[3]), gw), gw) for x in g))
    body.append("")
    ctot = (data.get("claude") or {}).get("totals") or {}
    otot = (data.get("opencode") or {}).get("today") or {}
    total = next((p for nm, p in data["pcts"] if nm == "cpu"), 0.0) or 0.0
    line = (f"  {t.c('dim', 'Claude')} {t.c('yellow', f'≈${float(ctot.get('cost_api') or 0):.2f}')}"
            f"  {t.c('dim', 'opencode')} {t.c('green', f'${float(otot.get('cost') or 0):.3f}')}"
            f"  {t.c('dim', 'CPU')} {t.c(pct_color(total), f'{total:.0f}%')}")
    if data.get("temp"):
        line += f"  {t.c(temp_color(data['temp']), f'{data['temp']:.0f}°C')}"
    body.append(line)
    return _framed(app, data, W, H, show_ms, paused, body)


