    return [l1, l2]


def cpu_lines(pcts, load, hist_cpu, hist_load, t, W, per_core=True):
    total = next((p for n, p in pcts if n == "cpu"), 0.0) or 0.0
    bw = 20 if W >= 60 else 12
    show_spark = W >= 50
    line = f"  {t.c('text', 'total')} {t.bar(total, bw)} {t.c(pct_color(total), f'{total:3.0f}%')}"
    if W >= 60:
        line += f"  {t.c('dim', f'{os.cpu_count() or 0} cores')}"
    if show_spark:
        line += f"  {sparkline(hist_cpu, t, 'gradient')}"
    lines = [line]
    if per_core:
        cores = [(n, p) for n, p in pcts if n != "cpu"]
        per_row = 4 if W >= 66 else 3 if W >= 48 else 2
        cbar = 5 if W >= 48 else 3
        for i in range(0, len(cores), per_row):
            row = "  "
            for name, p in cores[i:i + per_row]:
                p = p or 0.0
                label = name.replace("cpu", "C")
                row += (f"{t.c('dim', label)} {t.bar(p, cbar)} "
                        f"{t.c(pct_color(p), f'{p:3.0f}')}  ")
            lines.append(row.rstrip())
    load_line = f"  {t.c('dim', 'load')} {load[0]:.2f} {load[1]:.2f} {load[2]:.2f}"
    if show_spark:
        load_line += f"  {sparkline(hist_load, t, 'gradient')}"
    lines.append(load_line)
    return lines


def mem_lines(mem, temp, gpu, gt, hist_temp, t, W):
    lines = []
    bw = 16 if W >= 52 else 10
    show_spark = W >= 50
    if mem:
        total, used, st, su = mem
        pct = (used / total * 100) if total else 0
        line = (f"  {t.c('text', 'RAM')}  {t.bar(pct, bw)} {t.c(pct_color(pct), f'{pct:3.0f}%')}  "
                f"{used:.1f}/{total:.1f}G")
        if W >= 48:
            line += f"   {t.c('dim', 'swap')} {su:.1f}/{st:.1f}G"
        lines.append(line)
    if temp:
        tp = max(0.0, min(100.0, (temp - 30) / 60 * 100))
        line = f"  {t.c('text', 'temp')} {t.bar(tp, bw)} {t.c(temp_color(temp), f'{temp:3.0f}°C')}"
        if show_spark:
            line += f"  {sparkline(hist_temp, t, 'gradient')}"
        lines.append(line)
    if gpu is not None:
        extra = f"  {t.c('dim', 'gpu')} {gt:.0f}°C" if gt else ""
        lines.append(f"  {t.c('text', 'GPU')}  {t.bar(gpu, bw)} "
                     f"{t.c(pct_color(gpu), f'{gpu:3.0f}%')}{extra}")
    return lines


def power_lines(bat, t, W):
    if not bat or bat.get("cap") is None:
        return [f"  {t.c('dim', 'батарея не найдена')}"]
    cap = bat["cap"]
    col = "green" if cap > 40 else "yellow" if cap > 15 else "red"
    state_raw = bat.get("status") or "?"
    status_map = {"Charging": "зарядка", "Discharging": "разряд", "Full": "полный",
                  "Not charging": "не заряжается"}
    state = "AC" if bat.get("ac") else status_map.get(state_raw, state_raw)
    line = (f"  {t.c('text', 'BAT')} {t.bar(cap, 16)} {t.c(col, f'{cap:3.0f}%')}  "
            f"{t.c('dim', state)}")
    power = abs(bat["power"]) if bat.get("power") else 0
    if power and bat.get("energy") is not None and W >= 52:
        w = power / 1e6
        line += f"  {t.c('text', f'{w:.1f}W')}"
        if bat.get("ac") and bat.get("full") and bat["full"] > bat["energy"]:
            line += f"  {t.c('dim', 'full in')} {human_left((bat['full'] - bat['energy']) / power * 3600)}"
        elif not bat.get("ac"):
            line += f"  {t.c('dim', 'left')} {human_left(bat['energy'] / power * 3600)}"
    return [line]


def io_lines(disk, net, root_usage, iface, hist_io, t, W):
    lines = []
    show_spark = W >= 50
    if disk and root_usage:
        total, used, _ = root_usage
        pct = used / total * 100 if total else 0
        r, w = disk
        barw = 12 if W >= 52 else 8
        line = (f"  {t.c('text', 'disk')} {t.bar(pct, barw)} {t.c('dim', f'{used / 2**30:.0f}/{total / 2**30:.0f}G')}"
                f"  {t.c('dim', 'r')} {t.c('text', fmt_bytes(r))}/s"
                f"  {t.c('dim', 'w')} {t.c('text', fmt_bytes(w))}/s")
        if show_spark:
            line += f"  {sparkline(hist_io, t, 'gradient')}"
        lines.append(line)
    if net:
        rx, tx = net
        lines.append(
            f"  {t.c('text', 'net')}  {t.c('green', '↓')} {t.c('text', fmt_bytes(rx))}/s"
            f"  {t.c('blue', '↑')} {t.c('text', fmt_bytes(tx))}/s"
            f"  {t.c('dim', iface)}"
        )
    return lines


def proc_lines(procs, t, W):
    if not procs:
        return [f"  {t.c('dim', 'нет данных')}"]
    if W < 60:
        procs = procs[:3]
        row = "  " + "  ".join(
            f"{t.c('text', name[:8])} {t.c(pct_color(cpu), f'{cpu:3.0f}%')}"
            for cpu, _mem, name in procs
        )
        return [row]
    row = "  "
    for cpu, mem, name in procs:
        row += (f"{t.c('text', name[:16])} {t.c(pct_color(cpu), f'{cpu:3.0f}%')}"
                f"{t.c('dim', f'/{mem:.0f}%')}  ")
    return [row.rstrip()]


