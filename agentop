# ───────────── журнал лимитов: тренд, история окна, уведомления ─────────────
HISTORY_FILE = CACHE_DIR / "limits_history.jsonl"
NOTIFY_STATE = CACHE_DIR / "notified.json"
HISTORY_KEEP = 8 * 86400
LIMIT_WINDOWS = (("5h", "five_hour", 5 * 3600), ("7d", "seven_day", 7 * 86400))
_hist_cache = {"stamp": None, "rows": []}


def _iso_ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


def load_history():
    """Строки журнала; перечитываются только если файл изменился."""
    try:
        st = HISTORY_FILE.stat()
    except OSError:
        return []
    stamp = (st.st_mtime, st.st_size)
    if _hist_cache["stamp"] != stamp:
        rows = []
        try:
            with open(HISTORY_FILE, encoding="utf-8") as f:
                for line in f:
                    try:
                        r = json.loads(line)
                    except Exception:
                        continue
                    if isinstance(r, dict) and "ts" in r:
                        rows.append(r)
        except OSError:
            pass
        _hist_cache.update(stamp=stamp, rows=rows)
    return _hist_cache["rows"]


def record_limits(data, now=None):
    """Дописать точку: при изменении процентов или раз в 5 минут. Старше 8 дней — удаляется."""
    now = now or time.time()
    row = {"ts": round(now, 1)}
    for label, key, _ in LIMIT_WINDOWS:
        o = (data or {}).get(key) or {}
        if o.get("utilization") is None:
            continue
        row[label] = float(o["utilization"])
        row[label + "_reset"] = _iso_ts(o.get("resets_at"))
    if len(row) == 1:
        return False
    rows = load_history()
    if rows:
        last = rows[-1]
        same = all(last.get(k) == row.get(k) for k in ("5h", "7d"))
        if same and now - float(last.get("ts", 0)) < 300:
            return False
    try:
        keep = [r for r in rows if now - float(r.get("ts", 0)) < HISTORY_KEEP]
        if len(keep) < len(rows):
            tmp = HISTORY_FILE.with_suffix(".tmp")
            tmp.write_text("".join(json.dumps(r) + "\n" for r in keep + [row]))
            os.chmod(tmp, 0o600)
            tmp.replace(HISTORY_FILE)
        else:
            with open(HISTORY_FILE, "a", encoding="utf-8") as f:
                f.write(json.dumps(row) + "\n")
            os.chmod(HISTORY_FILE, 0o600)
        return True
    except OSError:
        return False


def window_history(lim, label, key):
    """Точки (ts, %) текущего окна лимита — по совпадению момента сброса (±2 мин)."""
    o = (lim or {}).get(key) or {}
    reset = _iso_ts(o.get("resets_at"))
    if reset is None or o.get("utilization") is None:
        return []
    pts = []
    for r in load_history():
        rr = r.get(label + "_reset")
        if label in r and rr is not None and abs(float(rr) - reset) < 120:
            pts.append((float(r["ts"]), float(r[label])))
    pts.sort()
    return pts


def recent_rate(pts, span=1800, min_span=600):
    """Скорость роста, %/с, по точкам за последние span секунд; None — мало данных."""
    if len(pts) < 2:
        return None
    end = pts[-1][0]
    win = [p for p in pts if p[0] >= end - span]
    if len(win) < 2 or win[-1][0] - win[0][0] < min_span:
        return None
    return max(0.0, (win[-1][1] - win[0][1]) / (win[-1][0] - win[0][0]))


def resample(values, n):
    vals = list(values)
    if len(vals) <= n:
        return vals
    return [vals[int(i * (len(vals) - 1) / (n - 1))] for i in range(n)]


def maybe_notify(lim, cfg, now=None, sender=None):
    """Уведомление на рабочий стол при пересечении порогов — один раз за окно."""
    if not _as_bool(cfg.get("notify"), True) or not lim or lim.get("error"):
        return []
    ths = []
    for x in cfg.get("notify_thresholds") or []:
        try:
            if 0 < float(x) <= 100:
                ths.append(float(x))
        except (TypeError, ValueError):
            pass
    if not ths:
        return []
    if sender is None:
        if not shutil.which("notify-send"):
            return []
        sender = _notify_send
    now = now or time.time()
    try:
        state = json.loads(NOTIFY_STATE.read_text())
        if not isinstance(state, dict):
            state = {}
    except Exception:
        state = {}
    sent = []
    for label, key, _ in LIMIT_WINDOWS:
        o = lim.get(key) or {}
        used = o.get("utilization")
        reset = _iso_ts(o.get("resets_at"))
        if used is None or reset is None or reset <= now:
            continue
        crossed = [th for th in ths if float(used) >= th]
        if not crossed:
            continue
        top = max(crossed)
        rid = f"{key}|{int(reset // 60)}"
        if f"{rid}|{top:g}" in state:
            continue
        for th in crossed:
            state[f"{rid}|{th:g}"] = now
        title = f"Claude: {label} лимит {float(used):.0f}%"
        body = f"сброс через {human_left(reset - now)}"
        sender(title, body, "critical" if top >= 95 else "normal")
        sent.append(title)
    if sent:
        state = {k: v for k, v in state.items() if now - float(v) < HISTORY_KEEP}
        try:
            tmp = NOTIFY_STATE.with_suffix(".tmp")
            tmp.write_text(json.dumps(state))
            tmp.replace(NOTIFY_STATE)
        except OSError:
            pass
    return sent


def _notify_send(title, body, urgency):
    try:
        subprocess.run(["notify-send", "-a", "AgentOp", "-u", urgency,
                        "-i", "dialog-warning", title, body],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except Exception:
        pass


def claude_today(ttl=TTL_CLAUDE, prices=None):
    today = datetime.now().astimezone().date().isoformat()
    if CLAUDE_CACHE.exists():
        try:
            c = json.loads(CLAUDE_CACHE.read_text())
            if (c.get("date") == today and c.get("v") == CLAUDE_CACHE_VERSION
                    and time.time() - c.get("ts", 0) < ttl):
                return c
        except Exception:
            pass

    midnight = datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    start = midnight.timestamp()
    seen = set()
    totals = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "messages": 0,
              "cost_api": 0.0}
    models = {}

    for path in glob.glob(str(HOME / ".claude/projects/**/*.jsonl"), recursive=True):
        try:
            if os.path.getmtime(path) < start:
                continue
        except OSError:
            continue
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if '"usage"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if d.get("type") != "assistant":
                        continue
                    msg = d.get("message") or {}
                    u = msg.get("usage")
                    if not u:
                        continue
                    try:
                        ts = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
                    except Exception:
                        continue
                    if ts < start:
                        continue
                    key = (d.get("requestId") or "", msg.get("id") or d.get("uuid"))
                    if key in seen:
                        continue
                    seen.add(key)
                    vals = {
                        "input": int(u.get("input_tokens") or 0),
                        "output": int(u.get("output_tokens") or 0),
                        "cache_read": int(u.get("cache_read_input_tokens") or 0),
                        "cache_write": int(u.get("cache_creation_input_tokens") or 0),
                    }
                    m = msg.get("model") or "?"
                    if m.startswith("<"):  # "<synthetic>" — служебные записи без вызова API
                        continue
                    totals["messages"] += 1
                    for k, v in vals.items():
                        totals[k] += v
                    mm = models.setdefault(m, {"input": 0, "output": 0, "cache_read": 0,
                                               "cache_write": 0, "messages": 0,
                                               "cost_api": 0.0})
                    for k, v in vals.items():
                        mm[k] += v
                    mm["messages"] += 1
                    cost = usage_cost(m, u, prices)
                    if cost is not None:
                        mm["cost_api"] += cost
                        totals["cost_api"] += cost
        except Exception:
            continue

    res = {"v": CLAUDE_CACHE_VERSION, "date": today, "ts": time.time(),
           "totals": totals, "models": models}
    try:
        tmp = CLAUDE_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(res))
        os.chmod(tmp, 0o600)
        tmp.replace(CLAUDE_CACHE)
    except Exception:
        pass
    return res


class ClaudeTail:
    """Инкрементальный хвост логов Claude — события (ts, output_tokens, model)."""

    def __init__(self, window=1800):
        self.window = window
        self.offset = {}
        self.seen = set()
        self.events = []
        self.feed = []
        self.prices = None
        self.last = 0.0
        self.last_save = 0.0
        self._load()

    def _load(self):
        try:
            d = json.loads(TAIL_CACHE.read_text())
            if time.time() - d.get("ts", 0) < 86400:
                self.offset = {k: int(v) for k, v in (d.get("offset") or {}).items()}
                self.events = [(float(a), int(b), c) for a, b, c in (d.get("events") or [])]
                self.feed = [e for e in (d.get("feed") or []) if isinstance(e, dict) and "ts" in e]
        except Exception:
            pass

    def _save(self):
        try:
            tmp = TAIL_CACHE.with_suffix(".tmp")
            tmp.write_text(json.dumps({
                "ts": time.time(),
                "offset": self.offset,
                "events": self.events[-5000:],
                "feed": self.feed[-300:],
            }))
            os.chmod(tmp, 0o600)
            tmp.replace(TAIL_CACHE)
            self.last_save = time.time()
        except Exception:
            pass

    def poll(self, force=False):
        now = time.time()
        if not force and now - self.last < 10:
            return
        self.last = now

        for path in glob.glob(str(HOME / ".claude/projects/**/*.jsonl"), recursive=True):
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            off = self.offset.get(path, 0)
            if size < off:
                off = 0
            try:
                old_mtime = os.path.getmtime(path)
            except OSError:
                continue
            if path not in self.offset and size and old_mtime < now - self.window:
                # старый файл: не читаем историю, начинаем с конца
                self.offset[path] = size
                continue
            try:
                with open(path, "rb") as f:
                    f.seek(off)
                    raw = f.read()
            except OSError:
                continue
            if not raw:
                self.offset[path] = off
                continue
            chunks = raw.split(b"\n")[:-1]
            self.offset[path] = off + sum(len(c) + 1 for c in chunks)
            for chunk in chunks:
                if b'"usage"' not in chunk:
                    continue
                try:
                    d = json.loads(chunk)
                except Exception:
                    continue
                if d.get("type") != "assistant":
                    continue
                msg = d.get("message") or {}
                u = msg.get("usage") or {}
                if not u:
                    continue
                try:
                    ts = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
                except Exception:
                    continue
                key = (d.get("requestId") or "", msg.get("id") or d.get("uuid"))
                if key in self.seen:
                    continue
                self.seen.add(key)
                model = msg.get("model") or "?"
                self.events.append((ts, int(u.get("output_tokens") or 0), model))
                if not model.startswith("<"):
                    self.feed.append({"ts": ts, "model": model, "out": int(u.get("output_tokens") or 0),
                                      "cache": int(u.get("cache_read_input_tokens") or 0),
                                      "cost": usage_cost(model, u, self.prices) or 0.0, "api": True})

        if len(self.seen) > 200_000:
            self.seen.clear()
        cutoff = time.time() - self.window
        self.events = [e for e in self.events if e[0] >= cutoff]
        self.feed.sort(key=lambda e: e["ts"])
        self.feed = self.feed[-300:]
        if now - self.last_save > 30:
            self._save()


class Speed:
    def __init__(self, window=1800):
        self.window = window
        self.claude = ClaudeTail(window)
        self.oc = []

    def update(self, force=False):
        self.claude.poll(force=force)
        self.oc = opencode_events(self.window)

    def events(self):
        return self.claude.events + self.oc

    def rate(self, seconds):
        if seconds <= 0:
            return 0.0
        now = time.time()
        total = sum(tok for ts, tok, _ in self.events() if ts >= now - seconds)
        return total / seconds

    def buckets(self, total=None, n=30):
        total = total or self.window
        now = time.time()
        step = total / n
        out = [0] * n
        for ts, tok, _ in self.events():
            if ts < now - total:
                continue
            ci = int((ts - (now - total)) // step)
            if ci < 0:
                continue
            idx = min(n - 1, ci)
            out[idx] += tok
        return out

    def peak(self, bucket=60, total=900):
        b = self.buckets(total, max(1, total // bucket))
        return max(b) / bucket if b else 0.0

    def snapshot(self):
        """Кэш метрик на 0.5 с, чтобы отрисовка не пересчитывала их слишком часто."""
        now = time.time()
        if getattr(self, "_snap", None) is not None and now - self._snap_ts < 0.5:
            return self._snap
        self._snap = {
            "now": self.rate(30),
            "avg1": self.rate(60),
            "avg5": self.rate(300),
            "peak": self.peak(60, 900),
            "buckets": self.buckets(900, 30),
        }
        self._snap_ts = now
        return self._snap


