                  "Not charging": "не заряжается"}
    state = "AC" if bat.get("ac") else status_map.get(state_raw, state_raw)
    line = (f"  {t.c('text', 'BAT')} {t.bar(cap, 16)} {t.c(col, f'{cap:3.0f}%')}  "
            f"{t.c('dim', state)}")
