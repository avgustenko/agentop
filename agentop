        hint = f"{t.c('dim', 'поиск: печатайте имя или PID')}  {key(t, 'Enter')} готово  {key(t, 'Esc')} сбросить"
    else:
        hint = (f"{key(t, '↑↓')} выбор  {key(t, 'x')} завершить  {key(t, 'c/m/n/i')} сортировка  "
                f"{key(t, 'g')} группы  {key(t, '/')} поиск  {key(t, 'd')} назад  {key(t, 'q')} выход")
    out.append(frame_bottom(t, W, hint))
    return [clip(x, W) for x in out[:H]]


