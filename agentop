    cw = W - 4
    body = [head(t, cw, "СВОДКА"), ""]
    for ln in brief_lines(data, t):
        for part in _wrap_ansi(ln, cw - 4):
            body.append("  " + part)
    return _framed(app, data, W, H, show_ms, paused, body)


# ── feed: лента ответов моделей ──
def opencode_feed(limit=80, window=6 * 3600):
    db = _oc_db()
    if not db.exists():
        return []
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=3)
        rows = con.execute(
            "select time_created, data from session_message where type='assistant' "
            "and time_created>=? order by time_created desc limit ?",
            (int((time.time() - window) * 1000), limit)).fetchall()
        con.close()
    except Exception:
        return []
    out = []
    for ts, raw in rows:
        try:
            d = json.loads(raw)
        except Exception:
            continue
        tk = d.get("tokens") or {}
        tok = int(tk.get("output") or 0) + int(tk.get("reasoning") or 0)
        if not tok:
            continue
        out.append({"ts": ts / 1000.0, "model": (d.get("model") or {}).get("id") or "?",
                    "out": tok, "cache": int((tk.get("cache") or {}).get("read") or 0),
                    "cost": float(d.get("cost") or 0), "api": False})
    return out


