class Procs:
    """Процессы по дельтам /proc/<pid>/stat между замерами.

    `ps %CPU` — среднее за всю жизнь процесса, поэтому только что
    нагрузивший CPU процесс в такой топ не попадает. Здесь — среднее
    за интервал между замерами (как в top/htop: 100% = одно ядро).
    """

    def __init__(self):
        try:
            self.hz = os.sysconf("SC_CLK_TCK")
            self.page = os.sysconf("SC_PAGE_SIZE")
        except (ValueError, OSError, AttributeError):
            self.hz, self.page = 100, 4096
        self.users = {}
        self.cmds = {}
        self.apps = {}
        self._snap = None
        self.prev = self._read()
        self.last = time.time()

    @staticmethod
    def _read():
        out = {}
        for d in glob.glob("/proc/[0-9]*"):
            try:
                raw = Path(d, "stat").read_text()
                uid = os.stat(d).st_uid
            except Exception:
                continue
            i, j = raw.find("("), raw.rfind(")")
            if i < 0 or j < 0:
                continue
            f = raw[j + 2:].split()
            try:
                # f[0]=state f[1]=ppid f[11]=utime f[12]=stime f[17]=threads f[21]=rss (страницы)
                out[int(d[6:])] = (raw[i + 1:j], int(f[11]) + int(f[12]), int(f[21]),
                                   f[0], int(f[17]), uid, int(f[1]))
            except (ValueError, IndexError):
                continue
        return out

    def user(self, uid):
        if uid not in self.users:
            try:
                self.users[uid] = pwd.getpwuid(uid).pw_name if pwd else str(uid)
            except (KeyError, AttributeError):
                self.users[uid] = str(uid)
        return self.users[uid]

    def cmdline(self, pid):
        key = (pid, self.prev.get(pid, ("",))[0])
        if key not in self.cmds:
            try:
                raw = Path(f"/proc/{pid}/cmdline").read_bytes()
                self.cmds[key] = raw.replace(b"\0", b" ").decode("utf-8", "replace").strip()
            except OSError:
                self.cmds[key] = ""
            if len(self.cmds) > 4000:
                self.cmds.clear()
        return self.cmds[key]

    INTERPRETERS = re.compile(r"^(python[\d.]*|node|nodejs|bun|deno|bash|sh|dash|zsh|fish|perl|ruby|java|gjs|electron)$")

    def app_name(self, pid, comm):
        """Имя приложения: исполняемый файл (дочерние процессы браузера → браузер)."""
        key = (pid, comm)
        if key not in self.apps:
            name = comm
            try:
                exe = os.path.basename(os.readlink(f"/proc/{pid}/exe")).replace(" (deleted)", "")
                if exe and not self.INTERPRETERS.match(exe) and not re.match(r"^[\d.]+$", exe):
                    name = exe
            except OSError:
                pass
            if name == comm and len(comm) >= 15:
                # comm обрезан ядром до 15 символов — берём argv[0]
                arg0 = os.path.basename(self.cmdline(pid).split(" ")[0]) if self.cmdline(pid) else ""
                if arg0.startswith(comm):
                    name = arg0
            self.apps[key] = name
            if len(self.apps) > 4000:
                self.apps.clear()
        return self.apps[key]

    def snapshot(self):
        """Все процессы: pid, имя, CPU% за интервал, память, потоки, владелец.

        Чаще раза в секунду не пересчитывается: на слишком коротком интервале
        CPU% у всех получается нулевым.
        """
        now = time.time()
        if self._snap is not None and now - self.last < 1.0:
            return self._snap
        cur = self._read()
        dt = max(0.05, now - self.last)
        mem = meminfo()
        mem_total = (mem[0] * 2**30) if mem and mem[0] else 0
        res = []
        for pid, (comm, ticks, rss, state, threads, uid, ppid) in cur.items():
            prev = self.prev.get(pid)
            cpu = max(0, ticks - prev[1]) / self.hz / dt * 100.0 if prev else 0.0
            rss_b = rss * self.page
            res.append({"pid": pid, "name": comm, "app": self.app_name(pid, comm), "cpu": cpu,
                        "mem": rss_b / mem_total * 100.0 if mem_total else 0.0,
                        "rss": rss_b, "state": state, "threads": threads,
                        "uid": uid, "user": self.user(uid), "ppid": ppid})
        self.prev, self.last = cur, now
        self._snap = res
        return res

    def top(self, n=5):
        me = os.getpid()
        res = [(x["cpu"], x["mem"], x["app"]) for x in self.snapshot() if x["pid"] != me]
        res.sort(key=lambda x: x[0], reverse=True)
        return res[:n]


