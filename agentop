        body.append(line)
    if not n:
        body.append("  " + t.c("dim", "ничего не найдено" if st.filter else "собираю список процессов…"))
    while len(body) < room + 2:
        body.append("")
    # строка состояния / подтверждение
    if st.confirm:
        c = st.confirm
        cnt = len(c["pids"])
        what = f"«{c['name']}»" + (f" ({cnt} процессов)" if cnt > 1 else f" (PID {c['pids'][0]})")
