        l1 = (f"  {t.c('dim', 'now')} {t.c(col, f'{now:6.2f}')} {t.c('dim', 'tok/s')}   "
              f"{t.c('dim', '1m')} {s['avg1']:5.2f}   {t.c('dim', '5m')} {s['avg5']:5.2f}   "
              f"{t.c('dim', 'peak')} {s['peak']:5.2f}")
    else:
        l1 = (f"  {t.c('dim', 'now')} {t.c(col, f'{now:6.2f}')} {t.c('dim', 'tok/s')}  "
              f"{t.c('dim', 'peak')} {s['peak']:5.2f}")
