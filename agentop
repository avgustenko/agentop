def top_procs(n=5):
    try:
        out = subprocess.run(
            ["ps", "-eo", "pid=,pcpu=,pmem=,comm=", "--sort=-pcpu"],
            capture_output=True, text=True, timeout=2,
        ).stdout
    except Exception:
        return []
    res = []
    skip = {os.getpid(), os.getppid()}
    for line in out.splitlines():
        p = line.split(None, 3)
        if len(p) < 4:
            continue
        try:
            pid = int(p[0])
        except ValueError:
            continue
        if pid in skip or p[3] in ("ps", "agentop"):
            continue
        res.append((float(p[1]), float(p[2]), p[3]))
        if len(res) >= n:
            break
    return res


