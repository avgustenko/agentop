def claude_limits(ttl=TTL_LIMITS, force=False):
    if not force and USAGE_CACHE.exists():
        try:
            if time.time() - USAGE_CACHE.stat().st_mtime < ttl:
                data = json.loads(USAGE_CACHE.read_text())
                if "_fetched_at" not in data:
                    data["_fetched_at"] = USAGE_CACHE.stat().st_mtime
                return data
        except Exception:
            pass

    token = None
    try:
        cred = json.loads((HOME / ".claude/.credentials.json").read_text())
        token = (cred.get("claudeAiOauth") or {}).get("accessToken")
    except Exception:
        pass
    if not token:
        return {"error": "нет токена Claude Code — запустите claude"}

    req = urllib.request.Request(
        "https://api.anthropic.com/api/oauth/usage",
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": f"agentop/{VERSION}",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=4) as r:
            data = json.loads(r.read().decode())
        data["_fetched_at"] = time.time()
        tmp = USAGE_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(data))
        os.chmod(tmp, 0o600)
        tmp.replace(USAGE_CACHE)
        return data
    except urllib.error.HTTPError as e:
        if e.code == 429:
            # не долбим API: продлеваем жизнь кэша и отдаём его молча
            if USAGE_CACHE.exists():
                try:
                    os.utime(USAGE_CACHE, None)
                    data = json.loads(USAGE_CACHE.read_text())
                    data["_throttled"] = True
                    if "_fetched_at" not in data:
                        data["_fetched_at"] = USAGE_CACHE.stat().st_mtime
                    return data
                except Exception:
                    pass
            return {"error": "Claude API: 429, попробуйте позже"}
        err = f"HTTP {e.code}"
    except Exception as e:
        err = e.__class__.__name__

    if USAGE_CACHE.exists():
        try:
            data = json.loads(USAGE_CACHE.read_text())
            data["_stale"] = True
            if "_fetched_at" not in data:
                data["_fetched_at"] = USAGE_CACHE.stat().st_mtime
            return data
        except Exception:
            pass
    return {"error": err}


def claude_today(ttl=TTL_CLAUDE):
    today = datetime.now().astimezone().date().isoformat()
    if CLAUDE_CACHE.exists():
        try:
            c = json.loads(CLAUDE_CACHE.read_text())
            if c.get("date") == today and time.time() - c.get("ts", 0) < ttl:
                return c
        except Exception:
            pass

    midnight = datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    start = midnight.timestamp()
    seen = set()
    totals = {"input": 0, "output": 0, "cache_read": 0, "cache_write": 0, "messages": 0}
    models = {}

    for path in glob.glob(str(HOME / ".claude/projects/**/*.jsonl"), recursive=True):
        try:
            if os.path.getmtime(path) < start:
                continue
        except OSError:
            continue
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if '"usage"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                    except Exception:
                        continue
                    if d.get("type") != "assistant":
                        continue
                    msg = d.get("message") or {}
                    u = msg.get("usage")
                    if not u:
                        continue
                    try:
                        ts = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
                    except Exception:
                        continue
                    if ts < start:
                        continue
                    key = (d.get("requestId") or "", msg.get("id") or d.get("uuid"))
                    if key in seen:
                        continue
                    seen.add(key)
                    vals = {
                        "input": int(u.get("input_tokens") or 0),
                        "output": int(u.get("output_tokens") or 0),
                        "cache_read": int(u.get("cache_read_input_tokens") or 0),
                        "cache_write": int(u.get("cache_creation_input_tokens") or 0),
                    }
                    totals["messages"] += 1
                    for k, v in vals.items():
                        totals[k] += v
                    m = msg.get("model") or "?"
                    mm = models.setdefault(m, {"input": 0, "output": 0,
                                               "cache_read": 0, "cache_write": 0})
                    for k, v in vals.items():
                        mm[k] += v
        except Exception:
            continue

    res = {"date": today, "ts": time.time(), "totals": totals, "models": models}
    try:
        tmp = CLAUDE_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(res))
        os.chmod(tmp, 0o600)
        tmp.replace(CLAUDE_CACHE)
    except Exception:
        pass
    return res


class ClaudeTail:
    """Инкрементальный хвост логов Claude — события (ts, output_tokens, model)."""

    def __init__(self, window=1800):
        self.window = window
        self.offset = {}
        self.seen = set()
        self.events = []
        self.last = 0.0
        self.last_save = 0.0
        self._load()

    def _load(self):
        try:
            d = json.loads(TAIL_CACHE.read_text())
            if time.time() - d.get("ts", 0) < 86400:
                self.offset = {k: int(v) for k, v in (d.get("offset") or {}).items()}
                self.events = [(float(a), int(b), c) for a, b, c in (d.get("events") or [])]
        except Exception:
            pass

    def _save(self):
        try:
            tmp = TAIL_CACHE.with_suffix(".tmp")
            tmp.write_text(json.dumps({
                "ts": time.time(),
                "offset": self.offset,
                "events": self.events[-5000:],
            }))
            os.chmod(tmp, 0o600)
            tmp.replace(TAIL_CACHE)
            self.last_save = time.time()
        except Exception:
            pass

    def poll(self, force=False):
        now = time.time()
        if not force and now - self.last < 10:
            return
        self.last = now

        for path in glob.glob(str(HOME / ".claude/projects/**/*.jsonl"), recursive=True):
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            off = self.offset.get(path, 0)
            if size < off:
                off = 0
            try:
                old_mtime = os.path.getmtime(path)
            except OSError:
                continue
            if path not in self.offset and size and old_mtime < now - self.window:
                # старый файл: не читаем историю, начинаем с конца
                self.offset[path] = size
                continue
            try:
                with open(path, "rb") as f:
                    f.seek(off)
                    raw = f.read()
            except OSError:
                continue
            if not raw:
                self.offset[path] = off
                continue
            chunks = raw.split(b"\n")[:-1]
            self.offset[path] = off + sum(len(c) + 1 for c in chunks)
            for chunk in chunks:
                if b'"usage"' not in chunk:
                    continue
                try:
                    d = json.loads(chunk)
                except Exception:
                    continue
                if d.get("type") != "assistant":
                    continue
                msg = d.get("message") or {}
                u = msg.get("usage") or {}
                if not u:
                    continue
                try:
                    ts = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
                except Exception:
                    continue
                key = (d.get("requestId") or "", msg.get("id") or d.get("uuid"))
                if key in self.seen:
                    continue
                self.seen.add(key)
                self.events.append((ts, int(u.get("output_tokens") or 0), msg.get("model") or "?"))

        if len(self.seen) > 200_000:
            self.seen.clear()
        cutoff = time.time() - self.window
        self.events = [e for e in self.events if e[0] >= cutoff]
        if now - self.last_save > 30:
            self._save()


class Speed:
    def __init__(self, window=1800):
        self.window = window
        self.claude = ClaudeTail(window)
        self.oc = []

    def update(self, force=False):
        self.claude.poll(force=force)
        self.oc = opencode_events(self.window)

    def events(self):
        return self.claude.events + self.oc

    def rate(self, seconds):
        if seconds <= 0:
            return 0.0
        now = time.time()
        total = sum(tok for ts, tok, _ in self.events() if ts >= now - seconds)
        return total / seconds

    def buckets(self, total=None, n=30):
        total = total or self.window
        now = time.time()
        step = total / n
        out = [0] * n
        for ts, tok, _ in self.events():
            if ts < now - total:
                continue
            ci = int((ts - (now - total)) // step)
            if ci < 0:
                continue
            idx = min(n - 1, ci)
            out[idx] += tok
        return out

    def peak(self, bucket=60, total=900):
        b = self.buckets(total, max(1, total // bucket))
        return max(b) / bucket if b else 0.0

    def snapshot(self):
        """Кэш метрик на 0.5 с, чтобы отрисовка не пересчитывала их слишком часто."""
        now = time.time()
        if getattr(self, "_snap", None) is not None and now - self._snap_ts < 0.5:
            return self._snap
        self._snap = {
            "now": self.rate(30),
            "avg1": self.rate(60),
            "avg5": self.rate(300),
            "peak": self.peak(60, 900),
            "buckets": self.buckets(900, 30),
        }
        self._snap_ts = now
        return self._snap


