# ── week: тепловая карта 7×24 ──
WEEK_CACHE = CACHE_DIR / "week.json"


def week_activity():
    """Выходные токены по часам за 7 дней (Claude Code + opencode)."""
    now = datetime.now().astimezone()
    day0 = now.replace(hour=0, minute=0, second=0, microsecond=0)
    start = day0.timestamp() - 6 * 86400
    grid = [[0] * 24 for _ in range(7)]

    def add(ts, tok):
        di = int((ts - start) // 86400)
        if 0 <= di < 7:
            grid[di][datetime.fromtimestamp(ts).hour] += tok

    seen = set()
    for path in glob.glob(str(HOME / ".claude/projects/**/*.jsonl"), recursive=True):
        try:
            if os.path.getmtime(path) < start:
                continue
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if '"usage"' not in line or '"assistant"' not in line:
                        continue
                    try:
                        d = json.loads(line)
                        msg = d.get("message") or {}
                        key = (d.get("requestId") or "", msg.get("id") or d.get("uuid"))
                        if key in seen:
                            continue
                        seen.add(key)
                        ts = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
                        add(ts, int((msg.get("usage") or {}).get("output_tokens") or 0))
                    except Exception:
                        continue
        except OSError:
            continue
    db = _oc_db()
    if db.exists():
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=3)
            for ts, raw in con.execute("select time_created, data from session_message "
                                       "where type='assistant' and time_created>=?", (int(start * 1000),)):
                try:
                    tk = json.loads(raw).get("tokens") or {}
                    add(ts / 1000.0, int(tk.get("output") or 0) + int(tk.get("reasoning") or 0))
                except Exception:
                    continue
            con.close()
        except Exception:
            pass
    res = {"ts": time.time(), "start": start, "grid": grid}
    try:
        tmp = WEEK_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(res))
        tmp.replace(WEEK_CACHE)
    except OSError:
        pass
    return res


def _week_view(app, data, W, H, show_ms, paused):
    t = app.theme
    cw = W - 4
    wk = app.cache.get("week")
    body = [head(t, cw, "НЕДЕЛЯ · ТОКЕНЫ ПО ЧАСАМ")]
    if not wk:
        body += ["", "  " + t.c("dim", "считаю активность за 7 дней по логам Claude Code и opencode…")]
        return _framed(app, data, W, H, show_ms, paused, body)
    grid, start = wk["grid"], wk["start"]
    cellw = 2 if cw >= 70 else 1
    hdr = "      " + "".join((f"{h:02d}" if h % 6 == 0 else "  ")[:cellw] if cellw == 1 else (f"{h:02d}" if h % 6 == 0 else "  ") for h in range(24))
    body += ["", t.c("dim", hdr)]
    flat = [v for row in grid for v in row]
    mx = max(flat) or 1
    pal = t.p["palette"]
    totals = [sum(r) for r in grid]
    tmax = max(totals) or 1
    now = datetime.now()
    for di in range(7):
        ts = start + di * 86400
        d = datetime.fromtimestamp(ts)
        today = d.date() == now.date()
        line = "  " + t.c("accent" if today else "text", WEEKDAYS_SHORT[d.weekday()]) + (t.c("accent", " ▸") if today else "  ")
        for h in range(24):
            v = grid[di][h]
            if today and h > now.hour:
                line += " " * cellw
            elif v <= mx * 0.02:
                line += t.c("dim", "·".ljust(cellw))
            else:
                k = v / mx
                line += _cell("■", pal[min(len(pal) - 1, int(k * len(pal)))]) + " " * (cellw - 1)
        if cw >= 60:
            line += " " + t.bar(totals[di] / tmax * 100, 8) + f" {fmt_tokens(totals[di]):>6}"
        body.append(line)
    body.append("")
    di, hh = max(((i, h) for i in range(7) for h in range(24)), key=lambda x: grid[x[0]][x[1]])
    legend = "  " + t.c("dim", "меньше ") + " ".join(_cell("■", c) for c in pal) + t.c("dim", " больше")
    if grid[di][hh]:
        legend += t.c("dim", "   самый плотный час: ") + WEEKDAYS_SHORT[datetime.fromtimestamp(start + di * 86400).weekday()].lower() + f" {hh:02d}:00"
    body.append(legend)
    w7 = lim_info(data, "7d", "seven_day")
    if w7 and not w7["expired"]:
        body.append(f"  {t.c('dim', 'недельный лимит')} {t.c(pct_color(w7['used']), f'{w7['used']:.1f}%')} "
                    f"{t.c('dim', f'· в среднем {fmt_tokens(sum(totals) / 7)} токенов в день · ↻ {human_left(w7['rem'] or 0)}')}")
    return _framed(app, data, W, H, show_ms, paused, body)


# ── tiles: плитки в рамках ──
def _box(t, title, lines, w, sev=None):
    bc = sev or "dim"
    inner = w - 4
    top = t.c(bc, "╭─ ") + t.c("text", title) + t.c(bc, " " + "─" * max(1, w - vlen(title) - 5) + "╮")
    out = [top] + [t.c(bc, "│ ") + _fitw(x, inner) + t.c(bc, " │") for x in lines]
    out.append(t.c(bc, "╰" + "─" * (w - 2) + "╯"))
    return out


