        body.append("  " + (t.c("red", "⚠ " + c["risk"]) if c.get("risk") else t.c("dim", "несохранённые данные в приложении могут пропасть")))
    else:
        msg = st.message if st.message and time.time() - st.message[2] < 8 else None
        if msg:
            body.append("  " + t.c(msg[1] if msg[1] in t.p else "text", msg[0]))
        elif n:
            r = st.rows[st.sel]
