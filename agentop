        if bat.get("ac") and bat.get("full") and bat["full"] > bat["energy"]:
            line += f"  {t.c('dim', 'full in')} {human_left((bat['full'] - bat['energy']) / power * 3600)}"
        elif not bat.get("ac"):
            line += f"  {t.c('dim', 'left')} {human_left(bat['energy'] / power * 3600)}"
    return [line]


