def big_text(s, wide=False):
    rows = []
    for r in range(3):
        parts = [BIG_DIGITS.get(ch, ("   ",) * 3)[r] for ch in s]
        line = " ".join(parts)
        rows.append("".join(c * 2 for c in line) if wide else line)
    return rows


def hhmm(ts):
    return datetime.fromtimestamp(ts).strftime("%H:%M")


def _cell(ch, n):
    return f"\033[38;5;{n}m{ch}\033[0m" if COLOR else ch


def _center(s, w):
    return " " * max(0, (w - vlen(s)) // 2) + s


def _fitw(s, w):
    return pad(clip(s, w), w)


def lim_info(data, label, key):
    lim = data.get("limits") or {}
    if lim.get("error"):
        return None
    o = lim.get(key) or {}
    if o.get("utilization") is None:
        return None
    used = float(o["utilization"])
    reset = _iso_ts(o.get("resets_at"))
    now = time.time()
    rem = (reset - now) if reset else None
    pts = list((data.get("limits_hist") or {}).get(label) or [])
    rate = recent_rate(pts + [(now, used)]) if pts else None
    proj = used + rate * rem if (rate is not None and rem and rem > 0) else None
    return {"used": used, "reset": reset, "rem": rem, "expired": window_expired(o),
            "pts": pts, "rate": rate, "proj": proj}


