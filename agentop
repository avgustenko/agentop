def model_price(model, overrides=None):
    """Цена по самому длинному совпадающему префиксу id модели (даты в id не мешают)."""
    table = dict(PRICES)
    if isinstance(overrides, dict):
        for k, v in overrides.items():
            if isinstance(v, (list, tuple)) and len(v) == 4:
                try:
                    table[k] = tuple(float(x) for x in v)
                except (TypeError, ValueError):
                    pass
    best = None
    for k in table:
        if model.startswith(k) and (best is None or len(k) > len(best)):
            best = k
    return table.get(best)


def usage_cost(model, u, overrides=None):
    """Стоимость одного ответа по ценам API, $; None — модель неизвестна."""
    p = model_price(model or "", overrides)
    if not p:
        return None
    pin, pout, pw5, pread = p
    cc = u.get("cache_creation") or {}
    w1h = int(cc.get("ephemeral_1h_input_tokens") or 0)
    w_all = int(u.get("cache_creation_input_tokens") or 0)
    w5 = max(0, w_all - w1h)
    cost = (int(u.get("input_tokens") or 0) * pin
            + int(u.get("output_tokens") or 0) * pout
            + w5 * pw5 + w1h * pin * 2
            + int(u.get("cache_read_input_tokens") or 0) * pread) / 1e6
    if u.get("speed") == "fast":
        cost *= 2
    return cost


