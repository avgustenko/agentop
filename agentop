def _as_int(value, default, lo=None, hi=None):
    try:
        v = int(value)
    except Exception:
        return default
    if lo is not None:
        v = max(lo, v)
    if hi is not None:
        v = min(hi, v)
    return v


def _as_float(value, default, lo=None, hi=None):
    try:
        v = float(value)
    except Exception:
        return default
    if lo is not None:
        v = max(lo, v)
    if hi is not None:
        v = min(hi, v)
    return v


def _as_bool(value, default=False):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in ("1", "true", "yes", "on", "да")
    if isinstance(value, (int, float)):
        return bool(value)
    return default


