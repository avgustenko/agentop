SPARK_CHARS = "▁▂▃▄▅▆▇█"
BRAILLE_BITS = ((0x01, 0x02, 0x04, 0x40), (0x08, 0x10, 0x20, 0x80))


def sparkline(values, t, color="accent", width=None):
    vals = list(values)
    if width:
        vals = vals[-width:]
    if not vals:
        return t.c("dim", "·")
    lo, hi = min(vals), max(vals)
    if hi - lo < 1e-9:
        flat = SPARK_CHARS[0] * len(vals)
        return t.c("dim" if color == "gradient" else color, flat)
    pal = t.p["palette"]
    if not COLOR:
        return "".join(SPARK_CHARS[int((v - lo) / (hi - lo) * 7)] for v in vals)
    out = []
    for v in vals:
        k = (v - lo) / (hi - lo)
        ch = SPARK_CHARS[int(k * 7)]
        if color == "gradient":
            ci = min(len(pal) - 1, int(k * (len(pal) - 1)))
            out.append(f"\033[38;5;{pal[ci]}m{ch}")
        else:
            out.append(ch)
    if color == "gradient":
        return "".join(out) + "\033[0m"
    return t.c(color, "".join(out))


def braille_graph(values, width, rows, t):
    """Многострочный график точками Брайля (2×4 точки на символ)."""
    width = max(4, int(width))
    rows = max(1, int(rows))
    src = list(values)
    if not src:
        return [t.c("dim", " " * width) for _ in range(rows)]
    if len(src) == 1:
        src = src * 2
    n = width * 2
    pts = []
    for i in range(n):
        x = (i / (n - 1)) * (len(src) - 1) if n > 1 else 0
        i0 = int(x)
        i1 = min(len(src) - 1, i0 + 1)
        fr = x - i0
        pts.append(src[i0] * (1 - fr) + src[i1] * fr)
    lo, hi = min(pts), max(pts)
    if hi - lo < 1e-9:
        hi = lo + 1
    dots = rows * 4
    cells = [[0] * width for _ in range(rows)]
    for xi, v in enumerate(pts):
        cx = xi // 2
        level = int((v - lo) / (hi - lo) * (dots - 1))
        for dy in (level - 1, level):
            if dy < 0:
                continue
            cy = rows - 1 - (dy // 4)
            if cy < 0:
                continue
            cells[cy][cx] |= BRAILLE_BITS[xi % 2][dy % 4]
    pal = t.p["palette"]
    out = []
    for ri, row in enumerate(cells):
        frac = (rows - 1 - ri) / max(1, rows - 1) if rows > 1 else 1.0
        ci = min(len(pal) - 1, int(frac * (len(pal) - 1)))
        line = "".join(chr(0x2800 + b) if b else " " for b in row)
        if not COLOR:
            out.append(line)
        else:
            out.append(f"\033[38;5;{pal[ci]}m{line}\033[0m")
    return out


# ───────────────────────────── форматирование ─────────────────────────────
def fmt_tokens(n):
    n = int(n or 0)
    if n >= 1_000_000_000:
        return f"{n / 1e9:.1f}B"
    if n >= 1_000_000:
        return f"{n / 1e6:.1f}M"
    if n >= 1_000:
        return f"{n / 1e3:.1f}K"
    return str(n)


def fmt_bytes(n):
    n = float(n or 0)
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024:
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n:.1f}P"


def human_left(seconds):
    seconds = int(seconds)
    if seconds < 0:
        return "0м"
    d, rem = divmod(seconds, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    if d:
        return f"{d}д {h}ч"
    if h:
        return f"{h}ч {m:02d}м"
    return f"{m}м"


def read_int(path, default=None):
    try:
        return int(Path(path).read_text().strip())
    except Exception:
        return default


def _as_int(value, default, lo=None, hi=None):
    try:
        v = int(value)
    except Exception:
        return default
    if lo is not None:
        v = max(lo, v)
    if hi is not None:
        v = min(hi, v)
    return v


def _as_float(value, default, lo=None, hi=None):
    try:
        v = float(value)
    except Exception:
        return default
    if lo is not None:
        v = max(lo, v)
    if hi is not None:
        v = min(hi, v)
    return v


def _as_bool(value, default=False):
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in ("1", "true", "yes", "on", "да")
    if isinstance(value, (int, float)):
        return bool(value)
    return default


