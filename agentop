            f"{key(t, 's')} настройки  {key(t, 'p')} пауза  {key(t, 'q')} выход")
    out = out[:max(1, H - 1)] + [hint]
    return [clip(x, W) for x in out]


# ── cockpit: крупные цифры ──
def _cockpit_view(app, data, W, H, show_ms, paused):
    t = app.theme
    cw = W - 4
    half = (cw - 5) // 2
    body = [""]

    def blk(label, key, title):
        info = lim_info(data, label, key)
        if not info or info["expired"]:
            return [t.c("dim", title), "", "  " + _no_limits(t, info), "", ""]
        big = big_text(f"{info['used']:.0f}%")
        col = pct_color(info["used"])
        side = [f"{t.c('dim', '↻')} {human_left(info['rem'] or 0)}",
                (f"{t.c('dim', 'тренд')} {info['rate'] * 3600:.0f}%/ч" if info["rate"] is not None else t.c("dim", "лимит")),
                (f"{t.c('dim', '→')} {t.c(_proj_color(info['proj']), f'{min(999, info['proj']):.0f}% к сбросу')}"
                 if info["proj"] is not None else t.c("dim", f"{100 - info['used']:.0f}% осталось"))]
        rows = [t.c("dim", title)]
        rows += [t.c(col, big[r]) + "   " + side[r] for r in range(3)]
        rows.append(t.bar(info["used"], max(8, half - 2)))
        return rows

    a = blk("5h", "five_hour", "5 ЧАСОВ")
    b = blk("7d", "seven_day", "7 ДНЕЙ")
    if cw >= 60:
        for i in range(max(len(a), len(b))):
            body.append("  " + _fitw(a[i] if i < len(a) else "", half) + "   " + (b[i] if i < len(b) else ""))
    else:
        body += ["  " + x for x in a] + [""] + ["  " + x for x in b]
    body.append("")
    now_s, _, buckets = _speed_now(data)
    ctot = (data.get("claude") or {}).get("totals") or {}
    otot = (data.get("opencode") or {}).get("today") or {}
    total = next((p for nm, p in data["pcts"] if nm == "cpu"), 0.0) or 0.0
    body.append(f"  {t.c('dim', 'tok/s')} {t.c('green', f'{now_s:.0f}')} {sparkline(buckets, t, 'gradient', 14)}"
                f"   {t.c('dim', 'Claude')} {t.c('yellow', f'≈${float(ctot.get('cost_api') or 0):.2f}')}"
                f"   {t.c('dim', 'opencode')} {t.c('green', f'${float(otot.get('cost') or 0):.2f}')}"
                f"   {t.c('dim', 'CPU')} {t.c(pct_color(total), f'{total:.0f}%')}")
    return _framed(app, data, W, H, show_ms, paused, body)


