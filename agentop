def frame_top(t, W, left, right):
    prefix = t.c("dim", "╭─ ")
    suffix = t.c("dim", " ─╮")
    gap = W - 8 - vlen(left) - vlen(right)
    if gap < 1:
        return t.c("dim", clip("╭─ " + left + " " + right + " ─╮", W))
    return prefix + left + " " + t.c("dim", "─" * gap) + " " + right + suffix


def frame_bottom(t, W, hint):
    prefix = t.c("dim", "╰─ ")
    suffix = t.c("dim", "─╯")
    gap = W - 6 - vlen(hint)
    if gap < 1:
        return t.c("dim", clip("╰─ " + hint + "─╯", W))
    return prefix + hint + " " + t.c("dim", "─" * gap) + suffix


def head(t, w, title):
    s = t.c("accent", "▐ ") + t.c("text", title) + " "
    fill = w - vlen(s)
    return s + (t.c("dim", "─" * fill) if fill > 0 else "")


def key(t, k):
    return t.c("accent", f"[{k}]")


def content_line(t, W, s):
    inner = W - 4
    return t.c("dim", "│ ") + pad(clip(s, inner), inner) + t.c("dim", " │")


def limits_lines(lim, t, W, decimals=3):
    lines = []
    if not lim or lim.get("error"):
        return [f"  {t.c('red', '⚠')} {t.c('dim', (lim or {}).get('error', 'нет данных'))}"]
    if lim.get("_stale"):
        lines.append(f"  {t.c('dim', '(кэш — сеть недоступна)')}")
    bw = 20 if W >= 60 else 12 if W >= 48 else 9
    show_left = W >= 56
    show_pace = W >= 60
    warn = []
    fmt_pct = lambda v: f"{float(v):.{decimals}f}%"
    for label, key, wlen in (("5h", "five_hour", 5 * 3600), ("7d", "seven_day", 7 * 86400)):
        o = lim.get(key) or {}
        used = o.get("utilization")
        if used is None:
            lines.append(f"  {t.c('text', label)}  {t.c('dim', 'нет данных')}")
            continue
        used = float(used)
        left = max(0.0, 100.0 - used)
        rem = None
        pace = None
        if o.get("resets_at"):
            try:
                reset = datetime.fromisoformat(o["resets_at"].replace("Z", "+00:00")).timestamp()
                rem = reset - time.time()
                elapsed = wlen - rem
                if elapsed > 60:
                    pace = used * wlen / elapsed
            except Exception:
                pass
        col = pct_color(used)
        line = f"  {t.c('text', label)}  {t.bar(used, bw)} {t.c(col, fmt_pct(used))}"
        if show_left:
            line += f"  {t.c('dim', 'left')} {t.c(col, fmt_pct(left))}"
        if rem is not None:
            line += f"  {t.c('dim', '↻')} {human_left(rem)}"
        if show_pace and pace is not None and used < 99.5:
            pcol = "red" if pace >= 105 else "yellow" if pace >= 85 else "dim"
            line += f"  {t.c('dim', 'pace')} {t.c(pcol, f'{pace:.1f}%')}"
        if used >= 99.5:
            warn.append(f"{label} лимит исчерпан" + (f", сброс через {human_left(rem)}" if rem and rem > 0 else ""))
        elif pace and pace >= 105 and rem and rem > 0:
            elapsed = wlen - rem
            rate = used / max(1, elapsed)
            warn.append(f"{label} хватит на {human_left((100 - used) / max(1e-9, rate))}")
        lines.append(line)
    if warn:
        lines.append(f"  {t.c('red', '⚠')} {t.c('red', ' · '.join(warn))}")
    return lines


def tokens_lines(cl, oc, t, W):
    ctot = (cl or {}).get("totals") or {}
    otot = (oc or {}).get("today") or {}
    lines = []
    cr = ctot.get("cache_read", 0)
    cw = ctot.get("cache_write", 0)
    inp = ctot.get("input", 0)
    out = ctot.get("output", 0)
    hit = (cr / (cr + cw + inp) * 100) if (cr + cw + inp) else 0

    if W >= 66:
        lines.append(
            f"  {t.c('accent', 'Claude')}   in {t.c('text', fmt_tokens(inp))}  "
            f"out {t.c('text', fmt_tokens(out))}  "
            f"cache {t.c('text', fmt_tokens(cr + cw))}  "
            f"{t.c('dim', str(ctot.get('messages', 0)) + ' msg')}  "
            f"{t.c('dim', 'hit')} {t.c('green', f'{hit:.1f}%')}"
        )
    else:
        lines.append(
            f"  {t.c('accent', 'Claude')}   {t.c('text', fmt_tokens(inp))} in · "
            f"{t.c('text', fmt_tokens(out))} out · "
            f"{t.c('text', fmt_tokens(cr + cw))} cache"
        )
    if oc:
        cost = float(otot.get("cost") or 0.0)
        midnight = datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
        hours = max(0.05, (time.time() - midnight.timestamp()) / 3600)
        burn = cost / hours
        out_total = otot.get("output", 0) + otot.get("reasoning", 0)
        all_cost = float(oc.get("all_cost") or 0.0)
        if W >= 66:
            lines.append(
                f"  {t.c('blue', 'opencode')} in {t.c('text', fmt_tokens(otot.get('input')))}  "
                f"out {t.c('text', fmt_tokens(out_total))}  "
                f"cache {t.c('text', fmt_tokens(otot.get('cache_read')))}  "
                f"{t.c('green', f'${cost:.3f}')}  "
                f"{t.c('dim', f'${burn:.2f}/ч · ${all_cost:.2f}')}"
            )
        else:
            lines.append(
                f"  {t.c('blue', 'opencode')} {t.c('text', fmt_tokens(otot.get('input')))} in · "
                f"{t.c('text', fmt_tokens(out_total))} out · "
                f"{t.c('green', f'${cost:.3f}')}"
            )
    else:
        lines.append(f"  {t.c('blue', 'opencode')} {t.c('dim', 'нет данных')}")
    return lines


