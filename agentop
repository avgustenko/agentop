class Cpu:
    def __init__(self):
        self.prev = self._read()

    @staticmethod
    def _read():
        out = []
        try:
            for line in Path("/proc/stat").read_text().splitlines():
                if not line.startswith("cpu"):
                    continue
                parts = line.split()
                name = parts[0]
                vals = [int(x) for x in parts[1:]]
                idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
                out.append((name, sum(vals), idle))
        except Exception:
            pass
        return out

    def pcts(self):
        cur = self._read()
        out = []
        for (name, total, idle), (_, pt, pi) in zip(cur, self.prev):
            dt = total - pt
            di = idle - pi
            out.append((name, None if dt <= 0 else max(0.0, min(100.0, 100.0 * (1 - di / dt)))))
        self.prev = cur
        return out


class DiskIO:
    def __init__(self):
        self.dev = self._root_disk()
        self.prev = self._read()
        self.last = time.time()

    @staticmethod
    def _root_disk():
        try:
            for line in Path("/proc/mounts").read_text().splitlines():
                p = line.split()
                if p[1] == "/":
                    name = os.path.basename(os.path.realpath(p[0]))
                    if name == "root":
                        # /dev/root: устройство берём из stat корня
                        st = os.stat("/")
                        link = f"/sys/dev/block/{os.major(st.st_dev)}:{os.minor(st.st_dev)}"
                        if os.path.exists(link):
                            name = os.path.basename(os.path.realpath(link))
                    sysdir = Path("/sys/class/block", name)
                    if (sysdir / "partition").exists():
                        # раздел → родительский диск (nvme0n1p6 → nvme0n1)
                        return os.path.basename(os.path.dirname(os.path.realpath(sysdir)))
                    if sysdir.exists():
                        return name  # целый диск или dm-N (LUKS/LVM)
                    m = re.match(r"^(nvme\d+n\d+|mmcblk\d+)p\d+$", name)
                    if m:
                        return m.group(1)
                    return re.sub(r"\d+$", "", name) or name
        except Exception:
            pass
        return "nvme0n1"

    def _read(self):
        try:
            for line in Path("/proc/diskstats").read_text().splitlines():
                p = line.split()
                if len(p) > 9 and p[2] == self.dev:
                    return int(p[5]), int(p[9])
        except Exception:
            pass
        return 0, 0

    def rates(self):
        cur = self._read()
        now = time.time()
        dt = max(0.001, now - self.last)
        r = (cur[0] - self.prev[0]) * 512 / dt if cur[0] >= self.prev[0] else 0
        w = (cur[1] - self.prev[1]) * 512 / dt if cur[1] >= self.prev[1] else 0
        self.prev = cur
        self.last = now
        return r, w


class NetIO:
    def __init__(self):
        self.iface = self._default_iface()
        self.prev = self._read() or (0, 0)
        self.last = time.time()
        self.last_check = self.last

    @staticmethod
    def _default_iface():
        # без вызова ip: читаем /proc/net/route
        try:
            with open("/proc/net/route") as f:
                next(f, None)
                for line in f:
                    p = line.split()
                    if len(p) > 7 and p[1] == "00000000" and p[7] == "00000000":
                        return p[0]
        except Exception:
            pass
        for d in sorted(glob.glob("/sys/class/net/*")):
            n = os.path.basename(d)
            if n != "lo" and os.path.exists(d + "/statistics/rx_bytes"):
                return n
        return "lo"

    def _read(self):
        try:
            base = f"/sys/class/net/{self.iface}/statistics"
            return (int(Path(base, "rx_bytes").read_text()),
                    int(Path(base, "tx_bytes").read_text()))
        except Exception:
            return None

    def _switch_iface(self):
        new = self._default_iface()
        if new != self.iface:
            self.iface = new
            self.prev = self._read() or (0, 0)
            self.last = time.time()
            return True
        return False

    def rates(self):
        now = time.time()
        if now - self.last_check >= 60:
            self.last_check = now
            if self._switch_iface():
                return 0.0, 0.0
        cur = self._read()
        if cur is None:
            if self._switch_iface():
                return 0.0, 0.0
            cur = (0, 0)
        dt = max(0.001, now - self.last)
        r = max(0, cur[0] - self.prev[0]) / dt
        t = max(0, cur[1] - self.prev[1]) / dt
        self.prev = cur
        self.last = now
        return r, t


class Battery:
    def __init__(self):
        self.base = None
        for p in sorted(Path("/sys/class/power_supply").glob("BAT*")):
            if (p / "capacity").exists():
                self.base = p
                break
        self.ac_path = None
        for p in sorted(Path("/sys/class/power_supply").glob("*")):
            try:
                if (p / "type").read_text().strip() in ("Mains", "USB", "USB_C"):
                    self.ac_path = p / "online"
                    break
            except Exception:
                continue

    def read(self):
        base = self.base
        if base is None:
            return None
        cap = read_int(base / "capacity")
        status = ""
        try:
            status = (base / "status").read_text().strip()
        except Exception:
            pass
        ac = bool(read_int(self.ac_path, 0)) if self.ac_path else False
        power = read_int(base / "power_now")
        energy = read_int(base / "energy_now")
        full = read_int(base / "energy_full")
        if energy is None:
            # некоторые ноутбуки отдают charge_now (µAh) и voltage_now (µV)
            charge = read_int(base / "charge_now")
            voltage = read_int(base / "voltage_now")
            if charge is not None and voltage is not None:
                energy = int(charge * voltage / 1e6)
                full = int((read_int(base / "charge_full") or 0) * voltage / 1e6)
        if power is None:
            current = read_int(base / "current_now")
            voltage = read_int(base / "voltage_now")
            if current is not None and voltage is not None:
                power = int(abs(current) * voltage / 1e6)
        return {"cap": cap, "status": status, "ac": ac,
                "power": power, "energy": energy, "full": full}


def meminfo():
    d = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            k, v = line.split(":", 1)
            d[k] = int(v.split()[0])
    except Exception:
        return None
    total = d.get("MemTotal", 0) / 1048576
    avail = d.get("MemAvailable", 0) / 1048576
    st = d.get("SwapTotal", 0) / 1048576
    sf = d.get("SwapFree", 0) / 1048576
    return total, total - avail, st, st - sf


