def _oc_db():
    return HOME / ".local/share/opencode/opencode.db"


def opencode_events(window=1800):
    db = _oc_db()
    if not db.exists():
        return []
    start = int((time.time() - window) * 1000)
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=3)
        rows = con.execute(
            "select time_created, data from session_message "
            "where type='assistant' and time_created>=?",
            (start,),
        ).fetchall()
        con.close()
    except Exception:
        return []
    out = []
    for ts, data in rows:
        try:
            d = json.loads(data)
        except Exception:
            continue
        tk = d.get("tokens") or {}
        tok = int(tk.get("output") or 0) + int(tk.get("reasoning") or 0)
        if tok:
            out.append((ts / 1000.0, tok, (d.get("model") or {}).get("id") or "?"))
    return out


def opencode_stats():
    db = _oc_db()
    if not db.exists():
        return None
    midnight = datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    start_ms = int(midnight.timestamp() * 1000)
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=3)
        rows = con.execute(
            "select data from session_message where type='assistant' and time_created>=?",
            (start_ms,),
        ).fetchall()
        all_cost = con.execute(
            "select coalesce(sum(json_extract(data,'$.cost')),0) "
            "from session_message where type='assistant'"
        ).fetchone()[0]
        con.close()
    except Exception:
        return None

    today = {"cost": 0.0, "input": 0, "output": 0, "reasoning": 0,
             "cache_read": 0, "cache_write": 0, "messages": 0}
    models = {}
    for (data,) in rows:
        try:
            d = json.loads(data)
        except Exception:
            continue
        tk = d.get("tokens")
        if not tk:
            continue
        today["messages"] += 1
        today["cost"] += float(d.get("cost") or 0)
        today["input"] += int(tk.get("input") or 0)
        today["output"] += int(tk.get("output") or 0)
        today["reasoning"] += int(tk.get("reasoning") or 0)
        cache = tk.get("cache") or {}
        today["cache_read"] += int(cache.get("read") or 0)
        today["cache_write"] += int(cache.get("write") or 0)
        mid = (d.get("model") or {}).get("id") or "?"
        m = models.setdefault(mid, {"cost": 0.0, "input": 0, "output": 0,
                                    "reasoning": 0, "cache_read": 0})
        m["cost"] += float(d.get("cost") or 0)
        m["input"] += int(tk.get("input") or 0)
        m["output"] += int(tk.get("output") or 0)
        m["reasoning"] += int(tk.get("reasoning") or 0)
        m["cache_read"] += int(cache.get("read") or 0)
    return {"today": today, "models": models, "all_cost": float(all_cost or 0)}


