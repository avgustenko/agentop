def short(app, data):
    lim = data["limits"] or {}
    parts = []
    if lim.get("error"):
        parts.append("claude --")
    else:
        for label, key in (("5h", "five_hour"), ("7d", "seven_day")):
            o = lim.get(key) or {}
            if o.get("utilization") is not None and window_expired(o):
                parts.append(f"{label} reset")
            elif o.get("utilization") is not None:
                parts.append(f"{label} {max(0, 100 - float(o['utilization'])):.0f}% left")
    parts.append(f"{data['speed'].rate(60):.0f} tok/s")
    otot = (data["opencode"] or {}).get("today") or {}
    if otot:
        parts.append(f"${float(otot.get('cost') or 0):.3f}")
    parts.append(f"load {data['load'][0]:.1f}")
    total = next((p for n, p in data["pcts"] if n == "cpu"), None)
    if total is not None:
        parts.append(f"cpu {total:.0f}%")
    if data["bat"] and data["bat"].get("cap") is not None:
        parts.append(f"bat {data['bat']['cap']}%")
    return " · ".join(parts)


def bar_summary(data):
    """Общие данные для статус-баров: текст, подсказка, уровень."""
    lim = data["limits"] or {}
    parts, tips, worst = [], [], 0.0
    if lim.get("error"):
        parts.append("claude --")
        tips.append(f"Claude: {lim['error']}")
    for label, key, _ in LIMIT_WINDOWS:
        o = lim.get(key) or {}
        u = o.get("utilization")
        if u is None or lim.get("error"):
            continue
        if window_expired(o):
            parts.append(f"{label} reset")
            tips.append(f"{label}: окно сброшено")
            continue
        worst = max(worst, float(u))
        parts.append(f"{label} {float(u):.0f}%")
        reset = _iso_ts(o.get("resets_at"))
        tips.append(f"{label}: {float(u):.0f}%" +
                    (f" · сброс через {human_left(reset - time.time())}" if reset else ""))
    ctot = (data["claude"] or {}).get("totals") or {}
    otot = (data["opencode"] or {}).get("today") or {}
    tips.append(f"Claude сегодня: out {fmt_tokens(ctot.get('output', 0))}, "
                f"≈${float(ctot.get('cost_api') or 0):.2f} по ценам API")
    if otot:
        tips.append(f"opencode сегодня: ${float(otot.get('cost') or 0):.3f}")
    tips.append(f"скорость: {data['speed'].rate(60):.0f} tok/s")
    level = "critical" if worst >= 95 else "warning" if worst >= 80 else "normal"
    return " · ".join(parts) or "claude", tips, level, worst


def waybar_out(app, data):
    text, tips, level, worst = bar_summary(data)
    return json.dumps({"text": text, "tooltip": "\n".join(tips), "class": level,
                       "alt": level, "percentage": int(round(worst))}, ensure_ascii=False)


PANEL_STYLES = ("text", "forecast", "dot", "cells", "countdown", "pulse", "rotate", "ring", "bars")
PANEL_HEX = {"critical": "#f38ba8", "warning": "#f9e2af", "good": "#a6e3a1", "dim": "#8d8da0"}


def _level(p):
    return "critical" if p >= 95 else "warning" if p >= 80 else "good"


def _png(w, h, rows):
    """Минимальный PNG RGBA без сторонних библиотек."""
    raw = b"".join(b"\x00" + bytes(v for px in row for v in px) for row in rows)

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


def _hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def ring_png(pct, size=32, color="#cba6f7"):
    """Кольцо-индикатор: заполнено по часовой стрелке от 12 часов, сглаживание 4×4."""
    fg, cx, ro = _hex_rgb(color), size / 2, size / 2 - 1
    ri = ro - size * 0.16
    rows = []
    for y in range(size):
        row = []
        for x in range(size):
            hit_fg = hit_bg = 0
            for sy in range(4):
                for sx in range(4):
                    px, py = x + (sx + 0.5) / 4 - cx, y + (sy + 0.5) / 4 - cx
                    d = math.hypot(px, py)
                    if ri <= d <= ro:
                        ang = (math.atan2(px, -py) % (2 * math.pi)) / (2 * math.pi)
                        if ang <= pct / 100:
                            hit_fg += 1
                        else:
                            hit_bg += 1
            if hit_fg >= hit_bg and hit_fg:
                row.append(fg + (int(255 * hit_fg / 16),))
            elif hit_bg:
                row.append((255, 255, 255, int(70 * hit_bg / 16)))
            else:
                row.append((0, 0, 0, 0))
        rows.append(row)
    return _png(size, size, rows)


def bars_png(a, b, w=28, h=32):
    """Два столбика: окно 5h и неделя."""
    rows = [[(0, 0, 0, 0)] * w for _ in range(h)]
    for x0, p in ((3, a), (16, b)):
        col = _hex_rgb(PANEL_HEX[_level(p)] if p >= 80 else "#cba6f7")
        top = h - 2 - round((h - 4) * max(0, min(100, p)) / 100)
        for y in range(2, h - 2):
            for x in range(x0, x0 + 9):
                rows[y][x] = col + (255,) if y >= top else (255, 255, 255, 60)
    return _png(w, h, rows)


def _pango(text, level=None):
    esc = str(text).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    col = PANEL_HEX.get(level) if level else None
    return f"<span color='{col}'>{esc}</span>" if col else esc


def panel_line(data, style):
    """Первая строка Argos: (разметка Pango, PNG или None)."""
    i5, i7 = lim_info(data, "5h", "five_hour"), lim_info(data, "7d", "seven_day")
    ok5 = i5 and not i5["expired"]
    ok7 = i7 and not i7["expired"]
    u5 = i5["used"] if ok5 else None
    u7 = i7["used"] if ok7 else None
    worst = max([u for u in (u5, u7) if u is not None] or [0])
    lvl5 = _level(u5) if u5 is not None else None
    now_s, _, buckets = _speed_now(data)
    if u5 is None and style not in ("pulse",):
        return _pango("claude --" if not i5 else "5h reset", "dim"), None
    if style == "forecast":
        p = i5["proj"] if i5["proj"] is not None else u5
        lv = "critical" if p >= 100 else "warning" if p >= 85 else "good"
        return "5h " + _pango("→", "dim") + " " + _pango(f"{min(999, p):.0f}%", lv), None
    if style == "dot":
        if u5 >= 80:
            return _pango(f"● 5h {u5:.0f}%", lvl5), None
        return _pango("●", "good"), None
    if style == "cells":
        f = round((100 - u5) / 10)
        return _pango("▮" * f, lvl5) + _pango("▯" * (10 - f), "dim"), None
    if style == "countdown":
        rem = max(0, int(i5["rem"] or 0))
        return _pango("●", lvl5) + f" ↻ {rem // 3600}:{rem % 3600 // 60:02d}", None
    if style == "pulse":
        v = buckets[-6:] or [0]
        hi = max(v) or 1
        return _pango("".join(SPARK_CHARS[int(x / hi * 7)] for x in v), "dim") + f" {now_s:.0f} t/s", None
    if style == "rotate":
        ctot = (data.get("claude") or {}).get("totals") or {}
        items = [_pango(f"5h {u5:.0f}%", lvl5 if u5 >= 80 else None),
                 (f"7d {u7:.0f}%" if u7 is not None else "7d --"),
                 f"{now_s:.0f} t/s", f"≈${float(ctot.get('cost_api') or 0):.0f}"]
        return items[int(time.time() // 3) % len(items)], None
    if style == "ring":
        col = PANEL_HEX[lvl5] if u5 >= 80 else "#cba6f7"
        return _pango(f"{u5:.0f}%", lvl5 if u5 >= 80 else None), ring_png(u5, 32, col)
    if style == "bars":
        return "", bars_png(u5, u7 if u7 is not None else 0)
    lv = _level(worst) if worst >= 80 else None
    return _pango(f"5h {u5:.0f}%" + (f" · 7d {u7:.0f}%" if u7 is not None else ""), lv), None


def argos_out(app, data, style=None):
    """Формат Argos/BitBar (расширение «Argos» для верхней панели GNOME)."""
    style = style or app.cfg.get("panel_style") or "text"
    if style not in PANEL_STYLES:
        style = "text"
    text, tips, level, _ = bar_summary(data)
    first, png = panel_line(data, style)
    line = first + " | font=monospace useMarkup=true"
    if png:
        line += f" image={base64.b64encode(png).decode()} imageWidth=16 imageHeight=16"
    term = shutil.which("ghostty") and "ghostty -e agentop" or "x-terminal-emulator -e agentop"
    out = [line, "---"] + [f"{x.replace('|', '/')} | font=monospace useMarkup=false" for x in tips]
    out += ["---", f"Открыть AgentOp | bash='{term}' terminal=false",
            f"Диспетчер задач | bash='{term.replace('-e agentop', '-e agentop --view tasks')}' terminal=false"]
    return "\n".join(out)


def json_out(app, data):
    lim = data["limits"] or {}
    otot = (data["opencode"] or {}).get("today") or {}
    ctot = (data["claude"] or {}).get("totals") or {}
    total = next((p for n, p in data["pcts"] if n == "cpu"), None)
    return json.dumps({
        "version": VERSION,
        "theme": app.theme.name,
        "limits": {"five_hour": lim.get("five_hour"), "seven_day": lim.get("seven_day"),
                   "error": lim.get("error"), "stale": lim.get("_stale", False)},
        "limits_history": {k: v for k, v in (data.get("limits_hist") or {}).items()},
        "claude": {"totals": ctot, "date": (data["claude"] or {}).get("date"),
                   "models": (data["claude"] or {}).get("models") or {}},
        "opencode": {"today": otot, "all_cost": (data["opencode"] or {}).get("all_cost"),
                     "models": (data["opencode"] or {}).get("models") or {}},
        "speed": {"now": data["speed"].rate(30), "avg5m": data["speed"].rate(300),
                  "peak": data["speed"].peak(60, 900)},
        "system": {"load": list(data["load"]), "cpu": total,
                   "cores": [p for n, p in data["pcts"] if n != "cpu"],
                   "mem": data["mem"], "temp": data["temp"],
                   "gpu": data["gpu"], "gpu_temp": data["gpu_temp"],
                   "battery": data["bat"], "disk": data["disk"],
                   "net": data["net"], "iface": data["iface"],
                   "uptime": data["uptime"]},
        "processes": data["procs"],
    }, ensure_ascii=False, indent=2)


# ───────────────────────────── main ─────────────────────────────
def main():
    ap = argparse.ArgumentParser(add_help=True, description="agentop — агенты и железо")
    ap.add_argument("--once", action="store_true", help="вывести один раз")
    ap.add_argument("--short", action="store_true", help="одна строка")
    ap.add_argument("--json", action="store_true", help="JSON")
    ap.add_argument("--waybar", action="store_true", help="JSON для модуля custom в Waybar")
    ap.add_argument("--argos", action="store_true", help="вывод для GNOME-расширения Argos")
    ap.add_argument("--panel-style", choices=PANEL_STYLES,
                    help="стиль индикатора для --argos: " + ", ".join(PANEL_STYLES))
    ap.add_argument("--refresh", "-r", action="store_true", help="сбросить кэш")
    ap.add_argument("--theme", help="тема на один запуск")
    ap.add_argument("--set-theme", help="сохранить тему в конфиг")
    ap.add_argument("--list-themes", action="store_true", help="список тем")
    ap.add_argument("--view", choices=VIEWS, help="вид: " + ", ".join(VIEWS))
    ap.add_argument("--list-views", action="store_true", help="список видов")
    ap.add_argument("--config", action="store_true", help="показать конфиг")
    ap.add_argument("--ms", action="store_true", help="часы с сантисекундами; включает -i 0.01 (нагружает)")
    ap.add_argument("--version", action="version", version=f"agentop {VERSION}")
    ap.add_argument("-i", "--interval", type=float, help="интервал обновления, сек")
    args = ap.parse_args()

    cfg = load_config()

    if args.list_themes:
        print("auto (по теме GNOME) +")
        for name in THEMES:
            print("  " + name)
        return

    if args.list_views:
        desc = {
            "dashboard": "агенты + система (две колонки на широких)",
            "focus": "только лимиты, токены и скорость",
            "system": "только железо",
            "compact": "компактная одна колонка",
            "minimal": "5–6 строк",
            "timeline": "ось окна 5h: история, прогноз к сбросу",
            "gauges": "стрелочные приборы: 5h, неделя, tok/s",
            "fuel": "лимит как бензобак: на сколько часов хватит",
            "brief": "сводка словами",
            "feed": "лента ответов моделей с ценой",
            "week": "тепловая карта недели 7×24",
            "tiles": "плитки в рамках, как btop",
            "cockpit": "крупные цифры для второго монитора",
            "sidebar": "узкая колонка (включается сама на узких)",
            "beacon": "всё окно цвета состояния",
            "tasks": "диспетчер задач: процессы, завершение",
        }
        for v in VIEWS:
            print(f"  {v:10s} {desc[v]}")
        return

    if args.set_theme:
        name = args.set_theme
        if name not in THEMES and name != "auto":
            print(f"неизвестная тема: {name}", file=sys.stderr)
            return 2
        cfg["theme"] = name
        save_config(cfg)
        print(f"тема сохранена: {name}")
        return

    if args.config:
        print(CONFIG_PATH)
        print(json.dumps(cfg, indent=2, ensure_ascii=False))
        return

    if args.theme:
        if args.theme not in THEMES and args.theme != "auto":
            print(f"неизвестная тема: {args.theme} (см. --list-themes)", file=sys.stderr)
            return 2
        cfg["theme"] = args.theme
    if args.view:
        cfg["view"] = args.view
    if args.refresh:
        clear_cache()

    one_shot = (args.once or args.short or args.json or args.waybar or args.argos
                or not (sys.stdout.isatty() and sys.stdin.isatty()))

    app = App(cfg, threaded=not one_shot)
    if args.view:
        app.view = args.view
    if args.refresh:
        app.force_limits = True
    interval = max(0.01, args.interval if args.interval is not None
                   else _as_float(cfg.get("interval"), 1.0, 0.01, 300.0))
    if args.ms and args.interval is None and interval > 0.05:
        interval = 0.01
    show_ms = bool(args.ms or _as_bool(cfg.get("clock_ms"), False))

    size = shutil.get_terminal_size((80, 24))
    W = max(24, min(size.columns - 1, 120))
    H = max(12, size.lines)

    if one_shot:
        time.sleep(0.35)
        data = app.sample()
        if args.json:
            print(json_out(app, data))
        elif args.waybar:
            print(waybar_out(app, data))
        elif args.argos:
            print(argos_out(app, data, args.panel_style))
        elif args.short:
            print(short(app, data))
        else:
            print("\n".join(render(app, data, W, H, show_ms=show_ms)))
        return

    # живой режим: альтернативный экран, курсор скрыт — терминал пользователя не затирается
    def draw(frame):
        # без полной очистки: каждая строка дочищается до конца (\033[K) — нет мерцания
        sys.stdout.write("\033[H" + frame.replace("\n", "\033[K\n") + "\033[K\033[J")

    fd = sys.stdin.fileno()
    sys.stdout.write("\033[?1049h\033[?25l")
    sys.stdout.flush()
    old_term = None
    if termios and tty and sys.stdin.isatty():
        try:
            old_term = termios.tcgetattr(fd)
            tty.setcbreak(fd)
        except Exception:
            old_term = None

    time.sleep(0.35)
    last_frame = None
    last_stamp = None
    last_settings_stamp = None
    last_size_check = 0.0
    paused = False
    settings = False
    settings_sel = 0
    data = None
    last_sample = 0.0
    try:
        while True:
            if settings:
                now_s = time.time()
                if now_s - last_size_check >= 0.5:
                    size = shutil.get_terminal_size((80, 24))
                    W = max(24, min(size.columns - 1, 120))
                    H = max(12, size.lines)
                    last_size_check = now_s
                stamp_s = (int(now_s), settings_sel, app.theme.name)
                if stamp_s != last_settings_stamp:
                    frame = "\n".join(render_settings(app, W, H, settings_sel))
                    if frame != last_frame:
                        draw(frame)
                        sys.stdout.flush()
                        last_frame = frame
                    last_settings_stamp = stamp_s
                r, _, _ = select.select([fd], [], [], 0.2)
                if not r:
                    continue
                k = read_key(fd)
                if k is None:
                    break
                if k in ("s", "S", "ESC", "q", "Q", "\x03"):
                    settings = False
                    last_frame = None
                    last_stamp = None
                    last_sample = 0.0
                    interval = max(0.01, min(300.0, _as_float(app.cfg.get("interval"), 1.0)))
                    show_ms = bool(args.ms or _as_bool(app.cfg.get("clock_ms"), False))
                    continue
                items = settings_items(app.cfg)
                if k in ("UP", "k", "K"):
                    settings_sel = (settings_sel - 1) % len(items)
                    last_settings_stamp = None
                elif k in ("DOWN", "j", "J"):
                    settings_sel = (settings_sel + 1) % len(items)
                    last_settings_stamp = None
                elif k in ("LEFT", "h", "H", "RIGHT", "l", "L", "ENTER", "\r", "\n"):
                    key_, label, choices = items[settings_sel]
                    cur = setting_get(app.cfg, key_)
                    idx = choice_index(choices, cur)
                    if k in ("LEFT", "h", "H"):
                        idx = (idx - 1) % len(choices)
                    elif isinstance(choices[0], bool):
                        idx = 1 - idx
                    else:
                        idx = (idx + 1) % len(choices)
                    apply_setting(app, key_, choices[idx])
                    last_frame = None
                    last_settings_stamp = None
                continue

            if paused:
                r, _, _ = select.select([fd], [], [], None)
                if not r:
                    continue
                ch = read_key(fd)
                if ch is None:
                    break
                if ch in ("q", "Q", "\x03", "ESC"):
                    break
                if ch in ("p", "P"):
                    paused = False
                    last_frame = None
                    last_stamp = None
                    last_sample = 0.0
                elif ch in ("s", "S"):
                    paused = False
                    settings = True
                    settings_sel = 0
                    last_settings_stamp = None
                    last_frame = None
                continue

            tick_start = time.time()
            now = tick_start
            if now - last_size_check >= 0.5:
                size = shutil.get_terminal_size((80, 24))
                W = max(24, min(size.columns - 1, 120))
                H = max(12, size.lines)
                last_size_check = now

            if data is None or now - last_sample >= interval:
                data = app.sample()
                last_sample = now
                last_stamp = None
            else:
                cached_limits = app.cache.get("limits")
                if cached_limits is not data.get("limits"):
                    data["limits"] = cached_limits
                    last_stamp = None

            stamp = (data["version"], int(now), W, H, app.theme.name)
            if last_stamp is None or show_ms or stamp != last_stamp:
                frame = "\n".join(render(app, data, W, H, show_ms=show_ms))
                if frame != last_frame:
                    draw(frame)
                    sys.stdout.flush()
                    last_frame = frame
                last_stamp = stamp

            wait = min(interval, 0.5)
            r, _, _ = select.select([fd], [], [], wait)
            if not r:
                continue
            ch = read_key(fd, translate=not (app.view == "tasks" and app.tasks.typing))
            if ch is None:
                break
            if ch == "\x03":
                break
            if app.view == "tasks" and tasks_key(app, ch):
                last_frame = None
                last_stamp = None
                if app.view != "tasks":
                    cfg["view"] = app.view
                continue
            if ch in ("q", "Q", "ESC"):
                break
            if ch in ("d", "D"):
                if app.view == "tasks":
                    app.view = app.tasks.back_view
                else:
                    app.tasks.back_view = app.view
                    app.view = "tasks"
                    app.ts.pop("tasks", None)
                last_sample = 0.0
                last_frame = None
                last_stamp = None
                continue
            if ch in ("r", "R"):
                clear_cache()
                app.ts.clear()
                kept = app.cache.get("limits")
                app.cache.clear()
                if kept:
                    app.cache["limits"] = kept
                app.force_limits = True
                app.speed.claude = ClaudeTail(1800)
                app.speed.update(force=True)
                last_sample = 0.0
                last_frame = None
                last_stamp = None
            elif ch in ("t", "T"):
                names = list(THEMES)
                cur = app.theme.name
                nxt = names[(names.index(cur) + 1) % len(names)] if cur in names else names[0]
                app.theme = Theme(nxt)
                cfg["theme"] = nxt
                persist_setting("theme", nxt)
                last_frame = None
                last_stamp = None
            elif ch in ("v", "V"):
                idx = VIEWS.index(app.view) if app.view in VIEWS else 0
                step = -1 if ch == "V" else 1
                app.view = VIEWS[(idx + step) % len(VIEWS)]
                if app.view == "tasks":
                    app.tasks.back_view = VIEWS[idx]
                    app.ts.pop("tasks", None)
                last_sample = 0.0
                cfg["view"] = app.view
                persist_setting("view", app.view)
                last_frame = None
                last_stamp = None
            elif ch in ("s", "S"):
                settings = True
                settings_sel = 0
                last_settings_stamp = None
                last_frame = None
            elif ch in ("p", "P"):
                paused = True
                frame = "\n".join(render(app, data, W, H, show_ms=show_ms, paused=True))
                if frame != last_frame:
                    draw(frame)
                    sys.stdout.flush()
                    last_frame = frame
    except (KeyboardInterrupt, OSError):
        pass
    finally:
        if old_term is not None:
            try:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_term)
            except Exception:
                pass
        try:
            app.speed.claude._save()
        except Exception:
            pass
        try:
            sys.stdout.write("\033[?25h\033[?1049l")
            sys.stdout.flush()
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main())
