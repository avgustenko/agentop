def _ru_num(n):
    n = float(n or 0)
    if n >= 1e6:
        return f"{n / 1e6:.1f}".replace(".", ",") + " млн"
    if n >= 1e3:
        return f"{n / 1e3:.0f} тыс."
    return f"{n:.0f}"


def _weekday_phrase(ts):
    d = datetime.fromtimestamp(ts)
    name = WEEKDAYS_ACC[d.weekday()]
    return ("во " if name == "вторник" else "в ") + name + " в " + d.strftime("%H:%M")


