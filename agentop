def _stacked(app, data, W, H, show_ms, paused, blocks, pc=True, big=False, options=None):
    t = app.theme
    cw = W - 4
    top = _header(app, data, W, show_ms)
    bottom = _footer(app, W, paused)

    def compose(per_core=True, optional=True, big_graph=big, tiny=False):
        out = [top]
        for name, title, lines, opt in blocks:
            if opt and not optional:
                continue
            if tiny and name == "mem":
                continue
            out.append(content_line(t, W, head(t, cw, title)))
            if name == "cpu":
                body = cpu_lines(data["pcts"], data["load"], data["hist_cpu"],
                                 data["hist_load"], t, cw, per_core=per_core)
            elif name == "speed":
                body = speed_lines(data["speed"], t, cw, big=big_graph)
            else:
                body = lines
            out.extend(content_line(t, W, x) for x in body)
        out.append(bottom)
        return [clip(x, W) for x in out]

    if options is None:
        options = [(pc, True, big, False), (pc, False, big, False)]
        if pc:
            options.append((False, False, big, False))
        options += [(False, False, False, False), (False, False, False, True)]
    for per_core, optional, big_graph, tiny in options:
        lines = compose(per_core, optional, big_graph, tiny)
        if len(lines) <= H:
            return lines
    return compose(False, False, False, True)[:H]


