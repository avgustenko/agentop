SYSTEM_PROCS = {
    "systemd", "init", "kthreadd", "gnome-shell", "Xwayland", "Xorg", "gdm", "gdm3",
    "gdm-session-wor", "gnome-session-b", "gnome-session-c", "dbus-daemon", "dbus-broker",
    "pipewire", "wireplumber", "pipewire-pulse", "NetworkManager", "systemd-logind",
    "polkitd", "sshd", "login", "mutter-x11-fram", "gsd-xsettings", "at-spi-bus-laun",
}


def _ancestors(pid):
    out, seen = [], set()
    while pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            raw = Path(f"/proc/{pid}/stat").read_text()
            pid = int(raw[raw.rfind(")") + 2:].split()[1])
        except (OSError, ValueError, IndexError):
            break
        out.append(pid)
    return out


def proc_risk(proc):
    """Почему этот процесс опасно или нельзя завершать; None — обычный процесс."""
    pid = proc["pid"]
    if pid == os.getpid():
        return "block", "это сам AgentOp — выйдите клавишей q"
    if pid == 1 or proc.get("ppid") == 2 or pid == 2:
        return "block", "процесс ядра или init — завершать нельзя"
    if pid in _ancestors(os.getpid()):
        return "warn", "это терминал или оболочка, в которой запущен AgentOp — он закроется тоже"
    if proc.get("name") in SYSTEM_PROCS or proc.get("app") in SYSTEM_PROCS:
        return "warn", "системный процесс — может завершиться сеанс или пропасть звук/сеть"
    if hasattr(os, "getuid") and proc.get("uid") not in (None, os.getuid()):
        return "warn", f"процесс пользователя {proc.get('user')} — без прав root не завершится"
    return None


def kill_pids(pids, sig):
    """Послать сигнал. Возвращает (ok, gone, denied) — списки pid."""
    ok, gone, denied = [], [], []
    for pid in pids:
        try:
            os.kill(pid, sig)
            ok.append(pid)
        except ProcessLookupError:
            gone.append(pid)
        except PermissionError:
            denied.append(pid)
    return ok, gone, denied


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    try:  # зомби считается завершённым
        return Path(f"/proc/{pid}/stat").read_text().split(") ")[-1][:1] != "Z"
    except OSError:
        return False


TASK_SORTS = {"c": "cpu", "m": "mem", "n": "name", "i": "pid"}
TASK_SORT_LABEL = {"cpu": "CPU", "mem": "память", "name": "имя", "pid": "PID"}


class TaskState:
    """Экран «Диспетчер задач»: выбор, сортировка, поиск, группы, подтверждение."""

    def __init__(self):
        self.sel = 0
        self.top = 0
        self.sort = "cpu"
        self.desc = True
        self.group = True
        self.filter = ""
        self.typing = False
        self.confirm = None      # {"name", "pids", "risk", "force"}
        self.pending = None      # {"name", "pids", "deadline"}
        self.message = None      # (текст, уровень, время)
        self.rows = []
        self.back_view = "dashboard"

    def say(self, text, level="text"):
        self.message = (text, level, time.time())


def task_rows(procs, st):
    """Строки списка с учётом поиска, групп и сортировки."""
    me = os.getpid()
    items = [p for p in (procs or []) if p["pid"] != me]
    if st.filter:
        q = st.filter.lower()
        items = [p for p in items if q in p["name"].lower() or q in p.get("app", "").lower() or q in str(p["pid"])]
    if st.group:
        groups = {}
        for p in items:
            app = p.get("app") or p["name"]
            g = groups.setdefault(app, {"name": app, "pids": [], "cpu": 0.0, "mem": 0.0,
                                              "rss": 0, "threads": 0, "users": set(), "pid": p["pid"],
                                              "uid": p["uid"], "user": p["user"], "ppid": p["ppid"]})
            g["pids"].append(p["pid"])
            g["cpu"] += p["cpu"]
            g["mem"] += p["mem"]
            g["rss"] += p["rss"]
            g["threads"] += p["threads"]
            g["users"].add(p["user"])
            g["pid"] = min(g["pid"], p["pid"])
        rows = list(groups.values())
        for g in rows:
            g["user"] = next(iter(g["users"])) if len(g["users"]) == 1 else "разные"
    else:
        rows = [dict(p, pids=[p["pid"]]) for p in items]
    key = st.sort
    if key == "name":
        rows.sort(key=lambda r: r["name"].lower(), reverse=not st.desc)
    else:
        rows.sort(key=lambda r: (r[key], r["rss"]), reverse=st.desc)
    return rows


def task_open_confirm(st, force=False):
    if not st.rows:
        return
    row = st.rows[min(st.sel, len(st.rows) - 1)]
    risks = [proc_risk(dict(row, pid=pid)) for pid in row["pids"]]
    block = next((r for r in risks if r and r[0] == "block"), None)
    if block:
        st.say(f"«{row['name']}»: {block[1]}", "red")
        return
    warn = next((r for r in risks if r), None)
    st.confirm = {"name": row["name"], "pids": list(row["pids"]),
                  "risk": warn[1] if warn else None, "force": force}


def task_do_kill(st, force):
    c = st.confirm
    st.confirm = None
    if not c:
        return
    sig = signal.SIGKILL if force else signal.SIGTERM
    ok, gone, denied = kill_pids(c["pids"], sig)
    n = len(c["pids"])
    what = f"«{c['name']}»" + (f" ({n} процессов)" if n > 1 else f" (PID {c['pids'][0]})")
    if denied and not ok:
        st.say(f"{what}: нет прав — это процесс другого пользователя; нужен sudo", "red")
        return
    if ok and not force:
        st.pending = {"name": c["name"], "pids": ok, "deadline": time.time() + 3}
        st.say(f"{what}: отправлен сигнал завершения…", "yellow")
    elif ok:
        st.pending = {"name": c["name"], "pids": ok, "deadline": time.time() + 1, "force": True}
        st.say(f"{what}: завершён принудительно", "green")
    elif gone:
        st.say(f"{what}: уже завершён", "dim")
    if denied and ok:
        st.say(f"{what}: часть процессов ({len(denied)}) без прав, остальные завершаются", "yellow")


def task_check_pending(st):
    """Через 3 с после SIGTERM: проверить, закрылось ли, иначе предложить SIGKILL."""
    pe = st.pending
    if not pe or time.time() < pe["deadline"]:
        return False
    st.pending = None
    alive = [pid for pid in pe["pids"] if pid_alive(pid)]
    if not alive:
        st.say(f"«{pe['name']}» завершён", "green")
    elif pe.get("force"):
        st.say(f"«{pe['name']}» не завершился даже принудительно (возможно, ждёт диск или ядро)", "red")
    else:
        st.confirm = {"name": pe["name"], "pids": alive, "force": True,
                      "risk": "процесс не ответил на обычное завершение за 3 с"}
    return True


def tasks_key(app, ch):
    """Клавиши экрана задач. True — клавиша обработана здесь."""
    st = app.tasks
    if st.confirm:
        if ch in ("y", "Y", "ENTER", "\r", "\n") and not st.confirm.get("force"):
            task_do_kill(st, False)
        elif ch in ("y", "Y", "ENTER", "\r", "\n", "K", "f", "F"):
            task_do_kill(st, True)
        elif ch in ("n", "N", "ESC", "q", "Q"):
            st.confirm = None
            st.say("отменено", "dim")
        return True
    if st.typing:
        if ch in ("ENTER", "\r", "\n"):
            st.typing = False
        elif ch == "ESC":
            st.typing = False
            st.filter = ""
        elif ch in ("\x7f", "\x08"):
            st.filter = st.filter[:-1]
        elif isinstance(ch, str) and len(ch) == 1 and ch.isprintable():
            st.filter += ch
        st.sel = st.top = 0
        return True
    n = len(st.rows)
    page = max(1, getattr(st, "page", 10))
    if ch in ("UP", "k"):
        st.sel = max(0, st.sel - 1)
    elif ch in ("DOWN", "j"):
        st.sel = min(max(0, n - 1), st.sel + 1)
    elif ch == "PGUP":
        st.sel = max(0, st.sel - page)
    elif ch == "PGDN":
        st.sel = min(max(0, n - 1), st.sel + page)
    elif ch == "HOME":
        st.sel = 0
    elif ch == "END":
        st.sel = max(0, n - 1)
    elif ch in ("x", "X", "DEL"):
        task_open_confirm(st)
    elif ch == "K":
        task_open_confirm(st, force=True)
    elif ch in TASK_SORTS:
        key = TASK_SORTS[ch]
        st.desc = (not st.desc) if st.sort == key else (key != "name")
        st.sort = key
    elif ch in ("g", "G"):
        st.group = not st.group
        st.sel = st.top = 0
    elif ch == "/":
        st.typing = True
        st.filter = ""
    elif ch == "ESC":
        if st.filter:
            st.filter = ""
        else:
            app.view = st.back_view if st.back_view != "tasks" else "dashboard"
    else:
        return False
    return True


