def frame_top(t, W, left, right):
    prefix = t.c("dim", "╭─ ")
    suffix = t.c("dim", " ─╮")
    gap = W - 8 - vlen(left) - vlen(right)
    if gap < 1:
        return t.c("dim", clip("╭─ " + left + " " + right + " ─╮", W))
    return prefix + left + " " + t.c("dim", "─" * gap) + " " + right + suffix


def frame_bottom(t, W, hint):
    prefix = t.c("dim", "╰─ ")
    suffix = t.c("dim", "─╯")
    gap = W - 6 - vlen(hint)
    if gap < 1:
        return t.c("dim", clip("╰─ " + hint + "─╯", W))
    return prefix + hint + " " + t.c("dim", "─" * gap) + suffix


def head(t, w, title):
    s = t.c("accent", "▐ ") + t.c("text", title) + " "
    fill = w - vlen(s)
    return s + (t.c("dim", "─" * fill) if fill > 0 else "")


def key(t, k):
    return t.c("accent", f"[{k}]")


def content_line(t, W, s):
    inner = W - 4
    return t.c("dim", "│ ") + pad(clip(s, inner), inner) + t.c("dim", " │")


def limits_lines(lim, t, W, decimals=3, hist=None):
    lines = []
    if not lim or lim.get("error"):
        return [f"  {t.c('red', '⚠')} {t.c('dim', (lim or {}).get('error', 'нет данных'))}"]
    if lim.get("_stale"):
        lines.append(f"  {t.c('dim', '(кэш — сеть недоступна)')}")
    bw = 20 if W >= 60 else 12 if W >= 48 else 9
    show_left = W >= 56
    show_pace = W >= 60
    warn = []
    fmt_pct = lambda v: f"{float(v):.{decimals}f}%"
    for label, key, wlen in (("5h", "five_hour", 5 * 3600), ("7d", "seven_day", 7 * 86400)):
        o = lim.get(key) or {}
        used = o.get("utilization")
        if used is None:
            lines.append(f"  {t.c('text', label)}  {t.c('dim', 'нет данных')}")
            continue
        if window_expired(o):
            lines.append(f"  {t.c('text', label)}  {t.c('green', 'окно сброшено')} "
                         f"{t.c('dim', '· ждём свежие данные')}")
            continue
        used = float(used)
        left = max(0.0, 100.0 - used)
        rem = None
        pace = None
        if o.get("resets_at"):
            try:
                reset = datetime.fromisoformat(o["resets_at"].replace("Z", "+00:00")).timestamp()
                rem = reset - time.time()
                elapsed = wlen - rem
                if elapsed > 60:
                    pace = used * wlen / elapsed
            except Exception:
                pass
        col = pct_color(used)
        line = f"  {t.c('text', label)}  {t.bar(used, bw)} {t.c(col, fmt_pct(used))}"
        if show_left:
            line += f"  {t.c('dim', 'left')} {t.c(col, fmt_pct(left))}"
        if rem is not None:
            line += f"  {t.c('dim', '↻')} {human_left(rem)}"
        if show_pace and pace is not None and used < 99.5:
            pcol = "red" if pace >= 105 else "yellow" if pace >= 85 else "dim"
            line += f"  {t.c('dim', 'pace')} {t.c(pcol, f'{pace:.1f}%')}"
        pts = list((hist or {}).get(label) or [])
        rrate = recent_rate(pts + [(time.time(), used)]) if pts else None
        if used >= 99.5:
            warn.append(f"{label} лимит исчерпан" + (f", сброс через {human_left(rem)}" if rem and rem > 0 else ""))
        elif rem and rem > 0:
            # прогноз по свежему темпу (30 мин журнала), иначе — по среднему с начала окна
            if rrate is not None:
                if used + rrate * rem >= 100 and rrate > 0:
                    warn.append(f"{label} хватит на {human_left((100 - used) / rrate)} (темп 30м)")
            elif pace and pace >= 105 and wlen - rem >= wlen * 0.1:
                # в первые 10% окна средний темп слишком шумный для прогноза
                rate = used / max(1, wlen - rem)
                warn.append(f"{label} хватит на {human_left((100 - used) / max(1e-9, rate))}")
        lines.append(line)
        if W >= 56 and len(pts) >= 2:
            vals = [u for _, u in pts] + [used]
            extra = f"      {sparkline(resample(vals, max(8, min(24, W - 42))), t, 'gradient')}"
            if rrate is not None and rem and rem > 0:
                proj = min(999.0, used + rrate * rem)
                pcol = "red" if proj >= 100 else "yellow" if proj >= 85 else "dim"
                extra += (f"  {t.c('dim', 'тренд 30м')} {rrate * 3600:.1f}%/ч"
                          f"  {t.c('dim', 'к сбросу')} {t.c(pcol, f'{proj:.0f}%')}")
            lines.append(extra)
    if warn:
        lines.append(f"  {t.c('red', '⚠')} {t.c('red', ' · '.join(warn))}")
    return lines


