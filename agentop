            line += f", ещё {t.c('text', human_left(bat['energy'] / abs(bat['power']) * 3600))}"
    out.append(line + ".")
    return out


def _wrap_ansi(s, w):
    """Перенос строки с цветами по словам."""
    if vlen(s) <= w:
        return [s]
    words, lines, cur = s.split(" "), [], ""
    for wd in words:
        cand = (cur + " " + wd) if cur else wd
        if vlen(cand) > w and cur:
            lines.append(cur)
            cur = wd
        else:
            cur = cand
    if cur:
        lines.append(cur)
    return lines


def _brief_view(app, data, W, H, show_ms, paused):
